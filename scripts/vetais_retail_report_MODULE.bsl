// =====================================================================
// МОДУЛЬ ФОРМЫ: Отчёт розничных продаж Vetais → 1С
// Вставьте этот код в модуль формы внешней обработки
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Значения по умолчанию
	Хост         = "localhost";
	Порт         = "5432";
	Пользователь = "postgres";
	ДатаС        = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ДатаПо       = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если ПустаяСтрока(Хост) Тогда
		Сообщить("Укажите Хост (сервер)!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(База) Тогда
		Сообщить("Укажите имя базы данных!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаС) Или Не ЗначениеЗаполнено(ДатаПо) Тогда
		Сообщить("Укажите период — Дата С и Дата По!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если ДатаПо < ДатаС Тогда
		Сообщить("Дата По не может быть раньше Даты С!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	ИспользуемыйПорт        = ?(ПустаяСтрока(Порт),        "5432",     Порт);
	ИспользуемыйПользователь = ?(ПустаяСтрока(Пользователь), "postgres", Пользователь);

	РезультатОтчета = СформироватьОтчетНаСервере(
		Хост,
		ИспользуемыйПорт,
		База,
		ИспользуемыйПользователь,
		Пароль,
		ДатаС,
		ДатаПо
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция СформироватьОтчетНаСервере(Хост, Порт, База, Пользователь, Пароль, ДатаОт, ДатаДо)

	// Строка подключения через psqlODBC
	// Драйвер: https://www.postgresql.org/ftp/odbc/versions/msi/
	СтрокаПодключения =
		"Driver={PostgreSQL ANSI(x64)};"
		+ "Server="   + Хост         + ";"
		+ "Port="     + Порт         + ";"
		+ "Database=" + База         + ";"
		+ "Uid="      + Пользователь + ";"
		+ "Pwd="      + Пароль       + ";"
		+ "UseServerSidePrepare=0;Sslmode=disable;";

	ДатаОтФорм = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатаДоФорм = Формат(ДатаДо, "ДФ=yyyy-MM-dd");

	ТекстЗапроса =
		"WITH totals AS ("
		+ " SELECT"
		+ "   sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 1) AS tovary,"
		+ "   sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 2) AS uslugi,"
		+ "   sum(ai.sum_with_vat) AS itogo"
		+ " FROM accounts_items ai"
		+ " JOIN accounts_headers ah ON ah.id = ai.account_header_id"
		+ " LEFT JOIN items_type it ON it.id = ai.item_type_id"
		+ " WHERE ai.deleted = 0"
		+ "   AND ah.deleted = 0"
		+ "   AND ah.datetime_create::date BETWEEN '"
		       + ДатаОтФорм + "' AND '" + ДатаДоФорм + "'"
		+ ") SELECT"
		+ "  round(coalesce(itogo,  0)::numeric, 2) AS itogo,"
		+ "  round(coalesce(uslugi, 0)::numeric, 2) AS uslugi,"
		+ "  round(coalesce(tovary, 0)::numeric, 2) AS tovary"
		+ " FROM totals";

	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionString = СтрокаПодключения;
		Соединение.CursorLocation  = 3; // adUseClient
		Соединение.Open();

		Команда = Новый COMОбъект("ADODB.Command");
		Команда.ActiveConnection = Соединение;
		Команда.CommandText      = ТекстЗапроса;
		Команда.CommandTimeout   = 60;

		РезультатАДО = Команда.Execute();

		Если Не РезультатАДО.EOF Тогда
			Итого  = РезультатАДО.Fields.Item("itogo").Value;
			Услуги = РезультатАДО.Fields.Item("uslugi").Value;
			Товары = РезультатАДО.Fields.Item("tovary").Value;

			Результат =
				"дата с "     + ДатаОтФорм +
				" по "        + ДатаДоФорм +
				" на сумму "  + Строка(Итого)  +
				", услуги: "  + Строка(Услуги) +
				", товары: "  + Строка(Товары);
		Иначе
			Результат = "Нет данных за выбранный период";
		КонецЕсли;

		РезультатАДО.Close();
		Соединение.Close();

		Возврат Результат;

	Исключение
		Возврат
			"ОШИБКА: " + ОписаниеОшибки() + Символы.ПС +
			"Проверьте:" + Символы.ПС +
			"1) Установлен ли psqlODBC драйвер" + Символы.ПС +
			"   https://www.postgresql.org/ftp/odbc/versions/msi/" + Символы.ПС +
			"2) Доступен ли сервер " + Хост + ":" + Порт + " с этого компьютера" + Символы.ПС +
			"3) Правильные ли реквизиты подключения";
	КонецПопытки;

КонецФункции

#КонецОбласти
