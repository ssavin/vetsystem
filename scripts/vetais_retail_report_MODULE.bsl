// =====================================================================
// МОДУЛЬ ФОРМЫ: Создание Отчёта о розничных продажах из Vetais
// =====================================================================
//
// КАК СОЗДАТЬ ОБРАБОТКУ В КОНФИГУРАТОРЕ:
//
// 1. Файл → Новый → Внешняя обработка
// 2. Добавить форму (Формы → Добавить → Основная: ДА)
// 3. В реквизитах формы добавить:
//    Имя                   Тип
//    ─────────────────────────────────────────────────────────────
//    ВыбраннаяБаза         Строка(200)
//    ДатаС                 Дата (Дата и время)
//    ДатаПо                Дата (Дата и время)
//    Организация           СправочникСсылка.Организации
//    Склад                 СправочникСсылка.Склады
//    НоменклатураУслуги    СправочникСсылка.Номенклатура
//    НоменклатураТовары    СправочникСсылка.Номенклатура
//    СтавкаНДС             ПеречислениеСсылка.СтавкиНДС
//    РезультатОтчета       Строка(500)
//
// 4. Разместить в форме:
//    [Поле выбора]  ВыбраннаяБаза     "База Vetais"
//    [Поле даты ]   ДатаС             "Период с"
//    [Поле даты ]   ДатаПо            "по"
//    [Поле выбора]  Организация       "Организация"
//    [Поле выбора]  Склад             "Склад"
//    [Поле выбора]  НоменклатураУслуги "Номенклатура (услуги)"
//    [Поле выбора]  НоменклатураТовары "Номенклатура (товары)"
//    [Поле выбора]  СтавкаНДС         "Ставка НДС"
//    [Кнопка]       СформироватьОтчет "Создать документ в 1С"
//    [Поле текста]  РезультатОтчета   "Результат" (только чтение)
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаС  = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ДатаПо = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));

	// Первая организация из справочника
	Организация = ПервыйЭлементСправочника("Организации");

	// Ставка НДС по умолчанию — Без НДС
	СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;

	ЗаполнитьСписокБаз();

КонецПроцедуры

&НаСервере
Функция ПервыйЭлементСправочника(ИмяСправочника)
	Выборка = Справочники[ИмяСправочника].Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники[ИмяСправочника].ПустаяСсылка();
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокБаз()
	Базы = Новый СписокЗначений;
	Базы.Добавить("probiko|localhost|5432|vetais_probiko_local|postgres|ASPI6rin",   "Probiko");
	Базы.Добавить("alisavet|45.128.206.134|5454|vetais_alisavet|postgres|ASPI6rin", "Алисавет");
	Базы.Добавить("dingo|109.173.124.18|5454|vetais|postgres|vetais",               "Динго");
	Базы.Добавить("vasilek|94.198.53.52|5454|vetais_vasilek|postgres|vetais",       "Василёк");
	Элементы.ВыбраннаяБаза.СписокВыбора.Загрузить(Базы);
	ВыбраннаяБаза = "probiko|localhost|5432|vetais_probiko_local|postgres|ASPI6rin";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если ПустаяСтрока(ВыбраннаяБаза) Тогда
		Сообщить("Выберите базу данных Vetais!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаС) Или Не ЗначениеЗаполнено(ДатаПо) Тогда
		Сообщить("Укажите период!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Укажите организацию!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НоменклатураУслуги)
		И Не ЗначениеЗаполнено(НоменклатураТовары) Тогда
		Сообщить("Укажите номенклатуру для услуг и/или товаров!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	РезультатОтчета = "Запрос к Vetais...";
	Результат = СоздатьОтчетОРозничныхПродажах(
		ВыбраннаяБаза,
		ДатаС,
		КонецДня(ДатаПо),
		Организация,
		Склад,
		НоменклатураУслуги,
		НоменклатураТовары,
		СтавкаНДС
	);

	РезультатОтчета = Результат.Сообщение;

	Если Результат.Успех Тогда
		// Открыть созданный документ
		ПоказатьЗначение(, Результат.ДокументСсылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ── Получить данные из Vetais ─────────────────────────────────────
&НаСервереБезКонтекста
Функция ПолучитьДанныеИзВетаис(СтрокаБазы, ДатаОт, ДатаДо)

	Части = СтрРазделить(СтрокаБазы, "|");

	СтрокаПодключения =
		"Driver={PostgreSQL ANSI(x64)};"
		+ "Server="   + Части[1] + ";"
		+ "Port="     + Части[2] + ";"
		+ "Database=" + Части[3] + ";"
		+ "Uid="      + Части[4] + ";"
		+ "Pwd="      + Части[5] + ";"
		+ "UseServerSidePrepare=0;Sslmode=disable;";

	ДатаОтФорм = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатаДоФорм = Формат(ДатаДо, "ДФ=yyyy-MM-dd");

	ТекстЗапроса =
		"WITH totals AS ("
		+ " SELECT"
		+ "   sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 1) AS tovary,"
		+ "   sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 2) AS uslugi,"
		+ "   sum(ai.sum_with_vat) AS itogo"
		+ " FROM accounts_items ai"
		+ " JOIN accounts_headers ah ON ah.id = ai.account_header_id"
		+ " LEFT JOIN items_type it ON it.id = ai.item_type_id"
		+ " WHERE ai.deleted = 0"
		+ "   AND ah.deleted = 0"
		+ "   AND ah.datetime_create::date BETWEEN '"
		+ ДатаОтФорм + "' AND '" + ДатаДоФорм + "'"
		+ ") SELECT"
		+ "  round(coalesce(itogo,  0)::numeric, 2) AS itogo,"
		+ "  round(coalesce(uslugi, 0)::numeric, 2) AS uslugi,"
		+ "  round(coalesce(tovary, 0)::numeric, 2) AS tovary"
		+ " FROM totals";

	Результат = Новый Структура("Успех, Итого, Услуги, Товары, Ошибка",
		Ложь, 0, 0, 0, "");

	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionString = СтрокаПодключения;
		Соединение.CursorLocation  = 3;
		Соединение.Open();

		Команда = Новый COMОбъект("ADODB.Command");
		Команда.ActiveConnection = Соединение;
		Команда.CommandText      = ТекстЗапроса;
		Команда.CommandTimeout   = 60;

		РезАДО = Команда.Execute();

		Если Не РезАДО.EOF Тогда
			Результат.Итого  = РезАДО.Fields.Item("itogo").Value;
			Результат.Услуги = РезАДО.Fields.Item("uslugi").Value;
			Результат.Товары = РезАДО.Fields.Item("tovary").Value;
			Результат.Успех  = Истина;
		КонецЕсли;

		РезАДО.Close();
		Соединение.Close();

	Исключение
		Результат.Ошибка =
			"ОШИБКА ПОДКЛЮЧЕНИЯ К VETAIS:" + Символы.ПС +
			ОписаниеОшибки() + Символы.ПС + Символы.ПС +
			"Проверьте:" + Символы.ПС +
			"1) Установлен ли psqlODBC: https://www.postgresql.org/ftp/odbc/versions/msi/" + Символы.ПС +
			"2) Доступен ли порт " + Части[2] + " на сервере " + Части[1] + " с этого компьютера";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// ── Создать документ "Отчёт о розничных продажах" в 1С ───────────
&НаСервереБезКонтекста
Функция СоздатьОтчетОРозничныхПродажах(
	СтрокаБазы, ДатаОт, ДатаДо,
	Организация, Склад,
	НоменклатураУслуги, НоменклатураТовары, СтавкаНДС)

	Рез = Новый Структура("Успех, Сообщение, ДокументСсылка", Ложь, "", Неопределено);

	// 1. Получить данные из Vetais
	Данные = ПолучитьДанныеИзВетаис(СтрокаБазы, ДатаОт, ДатаДо);

	Если Не Данные.Успех Тогда
		Рез.Сообщение = Данные.Ошибка;
		Возврат Рез;
	КонецЕсли;

	Если Данные.Итого = 0 Тогда
		Рез.Сообщение = "Нет данных за выбранный период";
		Возврат Рез;
	КонецЕсли;

	ДатаОтФорм = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатаДоФорм = Формат(КонецДня(ДатаДо), "ДФ=yyyy-MM-dd");

	// 2. Создать документ
	Попытка
		Документ = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
		Документ.Дата         = ДатаДо;
		Документ.Организация  = Организация;
		Если ЗначениеЗаполнено(Склад) Тогда
			Документ.Склад = Склад;
		КонецЕсли;
		Документ.Комментарий  =
			"Vetais: дата с " + ДатаОтФорм + " по " + ДатаДоФорм +
			" | итого: " + Данные.Итого;

		// 3. Заполнить табличную часть "Товары"
		//    Строка 1 — Услуги
		Если ЗначениеЗаполнено(НоменклатураУслуги) И Данные.Услуги > 0 Тогда
			СтрокаУслуги = Документ.Товары.Добавить();
			СтрокаУслуги.Номенклатура = НоменклатураУслуги;
			СтрокаУслуги.Количество   = 1;
			СтрокаУслуги.Цена         = Данные.Услуги;
			СтрокаУслуги.Сумма        = Данные.Услуги;
			СтрокаУслуги.СтавкаНДС    = СтавкаНДС;
			СтрокаУслуги.СуммаНДС     = 0;
		КонецЕсли;

		//    Строка 2 — Товары
		Если ЗначениеЗаполнено(НоменклатураТовары) И Данные.Товары > 0 Тогда
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Номенклатура = НоменклатураТовары;
			СтрокаТовары.Количество   = 1;
			СтрокаТовары.Цена         = Данные.Товары;
			СтрокаТовары.Сумма        = Данные.Товары;
			СтрокаТовары.СтавкаНДС    = СтавкаНДС;
			СтрокаТовары.СуммаНДС     = 0;
		КонецЕсли;

		// 4. Записать (без проведения — для проверки)
		Документ.Записать(РежимЗаписиДокумента.Запись);

		Рез.Успех          = Истина;
		Рез.ДокументСсылка = Документ.Ссылка;
		Рез.Сообщение      =
			"✅ Документ создан!" + Символы.ПС +
			"Период: " + ДатаОтФорм + " — " + ДатаДоФорм + Символы.ПС +
			"Итого:   " + Данные.Итого  + " руб." + Символы.ПС +
			"Услуги:  " + Данные.Услуги + " руб." + Символы.ПС +
			"Товары:  " + Данные.Товары + " руб." + Символы.ПС + Символы.ПС +
			"Документ открыт для проверки. Проведите его вручную.";

	Исключение
		Рез.Сообщение =
			"ОШИБКА СОЗДАНИЯ ДОКУМЕНТА В 1С:" + Символы.ПС +
			ОписаниеОшибки() + Символы.ПС + Символы.ПС +
			"Возможные причины:" + Символы.ПС +
			"- Отсутствует табличная часть 'Товары' в документе" + Символы.ПС +
			"- Не заполнен обязательный реквизит (Склад, КассаККМ и др.)" + Символы.ПС +
			"- Конфигурация не совпадает с БП 3.0";
	КонецПопытки;

	Возврат Рез;

КонецФункции

#КонецОбласти
