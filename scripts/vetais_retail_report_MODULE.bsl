// =====================================================================
// МОДУЛЬ ФОРМЫ: Отчёт розничных продаж Vetais → 1С
// =====================================================================
//
// КАК СОЗДАТЬ ОБРАБОТКУ В КОНФИГУРАТОРЕ:
//
// 1. Файл → Новый → Внешняя обработка
// 2. Добавить форму (Формы → Добавить → Основная: ДА)
// 3. В реквизитах формы добавить:
//    - ВыбраннаяБаза      Тип: Строка(100)
//    - ДатаС              Тип: Дата
//    - ДатаПо             Тип: Дата
//    - РезультатОтчета    Тип: Строка(0) - неограниченная
// 4. В форме разместить:
//    - Поле выбора "ВыбраннаяБаза"  с заголовком "База данных"
//    - Поле даты "ДатаС"            с заголовком "Период с"
//    - Поле даты "ДатаПо"           с заголовком "по"
//    - Кнопка "Сформировать"        команда: СформироватьОтчет
//    - Многострочное поле "РезультатОтчета"  только для чтения
// 5. Скопировать весь код ниже в модуль формы
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Период по умолчанию — прошлый месяц
	ДатаС  = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ДатаПо = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));

	// Заполнить список доступных баз
	ЗаполнитьСписокБаз();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если ПустаяСтрока(ВыбраннаяБаза) Тогда
		Сообщить("Выберите базу данных из списка!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаС) Или Не ЗначениеЗаполнено(ДатаПо) Тогда
		Сообщить("Укажите период — Дата С и Дата По!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если КонецДня(ДатаПо) < ДатаС Тогда
		Сообщить("Дата По не может быть раньше Даты С!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	РезультатОтчета = "Выполняется запрос...";
	РезультатОтчета = СформироватьОтчетНаСервере(ВыбраннаяБаза, ДатаС, КонецДня(ДатаПо));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ── Список доступных баз Vetais ───────────────────────────────────
&НаСервере
Процедура ЗаполнитьСписокБаз()

	// Формат строк: "Название|Хост|Порт|БазаДанных|Пользователь|Пароль"
	Базы = Новый СписокЗначений;
	Базы.Добавить("probiko|localhost|5432|vetais_probiko_local|postgres|ASPI6rin",   "Probiko (localhost)");
	Базы.Добавить("alisavet|45.128.206.134|5454|vetais_alisavet|postgres|ASPI6rin", "Алисавет");
	Базы.Добавить("dingo|109.173.124.18|5454|vetais|postgres|vetais",               "Динго");
	Базы.Добавить("vasilek|94.198.53.52|5454|vetais_vasilek|postgres|vetais",       "Василёк");

	Элементы.ВыбраннаяБаза.СписокВыбора.Загрузить(Базы);
	ВыбраннаяБаза = "probiko|localhost|5432|vetais_probiko_local|postgres|ASPI6rin";

КонецПроцедуры

// ── Разбор строки подключения ─────────────────────────────────────
Функция РазобратьПодключение(СтрокаБазы)
	Части = СтрРазделить(СтрокаБазы, "|");
	Пар = Новый Структура;
	Пар.Вставить("Хост",         Части[1]);
	Пар.Вставить("Порт",         Части[2]);
	Пар.Вставить("База",         Части[3]);
	Пар.Вставить("Пользователь", Части[4]);
	Пар.Вставить("Пароль",       Части[5]);
	Возврат Пар;
КонецФункции

// ── Основной запрос к PostgreSQL ──────────────────────────────────
&НаСервереБезКонтекста
Функция СформироватьОтчетНаСервере(СтрокаБазы, ДатаОт, ДатаДо)

	Части = СтрРазделить(СтрокаБазы, "|");
	Хост         = Части[1];
	Порт         = Части[2];
	База         = Части[3];
	Пользователь = Части[4];
	Пароль       = Части[5];

	// Строка подключения через psqlODBC
	// Скачать драйвер: https://www.postgresql.org/ftp/odbc/versions/msi/
	СтрокаПодключения =
		"Driver={PostgreSQL ANSI(x64)};"
		+ "Server="   + Хост         + ";"
		+ "Port="     + Порт         + ";"
		+ "Database=" + База         + ";"
		+ "Uid="      + Пользователь + ";"
		+ "Pwd="      + Пароль       + ";"
		+ "UseServerSidePrepare=0;Sslmode=disable;";

	ДатаОтФорм = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатаДоФорм = Формат(ДатаДо, "ДФ=yyyy-MM-dd");

	ТекстЗапроса =
		"WITH totals AS ("
		+ " SELECT"
		+ "   sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 1) AS tovary,"
		+ "   sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 2) AS uslugi,"
		+ "   sum(ai.sum_with_vat) AS itogo"
		+ " FROM accounts_items ai"
		+ " JOIN accounts_headers ah ON ah.id = ai.account_header_id"
		+ " LEFT JOIN items_type it ON it.id = ai.item_type_id"
		+ " WHERE ai.deleted = 0"
		+ "   AND ah.deleted = 0"
		+ "   AND ah.datetime_create::date BETWEEN '"
		       + ДатаОтФорм + "' AND '" + ДатаДоФорм + "'"
		+ ") SELECT"
		+ "  round(coalesce(itogo,  0)::numeric, 2) AS itogo,"
		+ "  round(coalesce(uslugi, 0)::numeric, 2) AS uslugi,"
		+ "  round(coalesce(tovary, 0)::numeric, 2) AS tovary"
		+ " FROM totals";

	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionString = СтрокаПодключения;
		Соединение.CursorLocation  = 3; // adUseClient
		Соединение.Open();

		Команда = Новый COMОбъект("ADODB.Command");
		Команда.ActiveConnection = Соединение;
		Команда.CommandText      = ТекстЗапроса;
		Команда.CommandTimeout   = 60;

		РезультатАДО = Команда.Execute();

		Если Не РезультатАДО.EOF Тогда
			Итого  = РезультатАДО.Fields.Item("itogo").Value;
			Услуги = РезультатАДО.Fields.Item("uslugi").Value;
			Товары = РезультатАДО.Fields.Item("tovary").Value;

			Результат =
				"дата с "    + ДатаОтФорм +
				" по "       + ДатаДоФорм +
				" на сумму " + Строка(Итого)  +
				", услуги: " + Строка(Услуги) +
				", товары: " + Строка(Товары);
		Иначе
			Результат = "Нет данных за выбранный период";
		КонецЕсли;

		РезультатАДО.Close();
		Соединение.Close();
		Возврат Результат;

	Исключение
		Возврат
			"ОШИБКА ПОДКЛЮЧЕНИЯ:" + Символы.ПС +
			ОписаниеОшибки()      + Символы.ПС + Символы.ПС +
			"Проверьте:" + Символы.ПС +
			"1) Установлен ли psqlODBC: https://www.postgresql.org/ftp/odbc/versions/msi/" + Символы.ПС +
			"2) Доступен ли сервер " + Хост + ":" + Порт + " с этого компьютера" + Символы.ПС +
			"3) Открыт ли порт в файерволе сервера";
	КонецПопытки;

КонецФункции

#КонецОбласти
