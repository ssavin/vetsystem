// ── Инициализация значений по умолчанию ──────────────────────
&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Значения по умолчанию — Probiko (локальный)
    Хост         = "194.5.78.182";
    Порт         = "5432";
    База         = "vetais_probiko_local";
    Пользователь = "postgres";
    Пароль       = "ASPI6rin";
    // Прошлый месяц
    ТекДата      = ТекущаяДата();
    ДатаС        = НачалоМесяца(ДобавитьМесяц(ТекДата, -1));
    ДатаПо       = КонецМесяца(ДобавитьМесяц(ТекДата, -1));
КонецПроцедуры

// ── Кнопка «Сформировать» ────────────────────────────────────
&НаКлиенте
Процедура СформироватьОтчет(Команда)
    Если ПустаяСтрока(Хост) Или ПустаяСтрока(База) Тогда
        Предупреждение("Заполните параметры подключения!");
        Возврат;
    КонецЕсли;
    СформироватьОтчетНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере()
    Попытка
        // Открываем ADODB-соединение с PostgreSQL через ODBC
        Соединение = Новый COMОбъект("ADODB.Connection");
        Соединение.ConnectionTimeout = 15;
        Соединение.CommandTimeout    = 60;

        СтрокаПодключения =
            "Driver={PostgreSQL Unicode(x64)};" +
            "Server="   + Хост         + ";" +
            "Port="     + Порт         + ";" +
            "Database=" + База         + ";" +
            "Uid="      + Пользователь + ";" +
            "Pwd="      + Пароль       + ";" +
            "UseDeclareFetch=1;Fetch=1000;";

        Соединение.Open(СтрокаПодключения);

        СтрДатаС  = Формат(ДатаС,  "ДФ=yyyy-MM-dd");
        СтрДатаПо = Формат(ДатаПо, "ДФ=yyyy-MM-dd");

        // Итоговый запрос: суммы по типам (1=товары, 2=услуги)
        ТекстSQL =
        "SELECT" +
        "  round(coalesce(sum(ai.sum_with_vat), 0)::numeric, 2) AS itogo," +
        "  round(coalesce(sum(CASE WHEN it.id_type = 2 THEN ai.sum_with_vat ELSE 0 END), 0)::numeric, 2) AS uslugi," +
        "  round(coalesce(sum(CASE WHEN it.id_type = 1 THEN ai.sum_with_vat ELSE 0 END), 0)::numeric, 2) AS tovary," +
        "  round(coalesce(sum(CASE WHEN it.id_type NOT IN (1,2) AND it.id_type IS NOT NULL THEN ai.sum_with_vat ELSE 0 END), 0)::numeric, 2) AS prochee" +
        " FROM accounts_items ai" +
        " JOIN accounts_headers ah ON ah.id = ai.account_header_id" +
        " LEFT JOIN items_type it ON it.id = ai.item_type_id" +
        " WHERE ai.deleted = 0" +
        "   AND ah.deleted = 0" +
        "   AND ah.datetime_create::date BETWEEN '" + СтрДатаС + "' AND '" + СтрДатаПо + "'";

        Набор = Соединение.Execute(ТекстSQL);

        Если НЕ Набор.EOF Тогда
            Итого  = Набор.Fields.Item("itogo").Value;
            Услуги = Набор.Fields.Item("uslugi").Value;
            Товары = Набор.Fields.Item("tovary").Value;
            Прочее = Набор.Fields.Item("prochee").Value;

            СтрРезультат =
                "дата с " + СтрДатаС + " по " + СтрДатаПо +
                " на сумму " + Строка(Итого) +
                ", услуги: " + Строка(Услуги) +
                ", товары: " + Строка(Товары);

            Если Прочее <> 0 Тогда
                СтрРезультат = СтрРезультат + ", прочее: " + Строка(Прочее);
            КонецЕсли;

            РезультатОтчета = СтрРезультат;
        Иначе
            РезультатОтчета = "Данные за указанный период не найдены.";
        КонецЕсли;

        Набор.Close();
        Соединение.Close();

    Исключение
        РезультатОтчета = "Ошибка подключения: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

// ── Кнопка «Скопировать» ─────────────────────────────────────
&НаКлиенте
Процедура СкопироватьВБуфер(Команда)
    Если ПустаяСтрока(РезультатОтчета) Тогда
        Предупреждение("Сначала сформируйте отчёт!");
        Возврат;
    КонецЕсли;
    ПоместитьВБуферОбмена(РезультатОтчета);
    Предупреждение("Строка скопирована в буфер обмена!");
КонецПроцедуры

// ── Кнопка «Детализация» (по типам номенклатуры) ─────────────
&НаКлиенте
Процедура ПоказатьДетализацию(Команда)
    Если ПустаяСтрока(Хост) Тогда
        Предупреждение("Заполните параметры подключения!");
        Возврат;
    КонецЕсли;
    ПоказатьДетализациюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПоказатьДетализациюНаСервере()
    Попытка
        Соединение = Новый COMОбъект("ADODB.Connection");
        Соединение.ConnectionTimeout = 15;

        СтрокаПодключения =
            "Driver={PostgreSQL Unicode(x64)};" +
            "Server="   + Хост         + ";" +
            "Port="     + Порт         + ";" +
            "Database=" + База         + ";" +
            "Uid="      + Пользователь + ";" +
            "Pwd="      + Пароль       + ";";

        Соединение.Open(СтрокаПодключения);

        СтрДатаС  = Формат(ДатаС,  "ДФ=yyyy-MM-dd");
        СтрДатаПо = Формат(ДатаПо, "ДФ=yyyy-MM-dd");

        ТекстSQL =
        "SELECT coalesce(it.name, 'Без типа') AS tip," +
        "  count(DISTINCT ah.id) AS schетов," +
        "  count(ai.id) AS poziciy," +
        "  round(sum(ai.sum_with_vat)::numeric, 2) AS summa" +
        " FROM accounts_items ai" +
        " JOIN accounts_headers ah ON ah.id = ai.account_header_id" +
        " LEFT JOIN items_type it ON it.id = ai.item_type_id" +
        " WHERE ai.deleted = 0 AND ah.deleted = 0" +
        "   AND ah.datetime_create::date BETWEEN '" + СтрДатаС + "' AND '" + СтрДатаПо + "'" +
        " GROUP BY it.name ORDER BY summa DESC";

        Набор = Соединение.Execute(ТекстSQL);

        СтрДетализация = "Детализация за " + СтрДатаС + " — " + СтрДатаПо + ":" + Символы.ПС;
        Пока НЕ Набор.EOF Цикл
            СтрДетализация = СтрДетализация +
                "  " + Набор.Fields.Item("tip").Value +
                ": счетов=" + Набор.Fields.Item("schетов").Value +
                ", позиций=" + Набор.Fields.Item("poziciy").Value +
                ", сумма=" + Набор.Fields.Item("summa").Value +
                Символы.ПС;
            Набор.MoveNext();
        КонецЦикла;

        Набор.Close();
        Соединение.Close();

        РезультатОтчета = СтрДетализация;

    Исключение
        РезультатОтчета = "Ошибка: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры
