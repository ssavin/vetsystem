// =====================================================================
// ВНЕШНЯЯ ОБРАБОТКА 1С: Накладная прихода в базу Vetais
// v1.0 — создание purchase_headers + purchase_items из XLS или 1С документа
// =====================================================================
//
// НАЗНАЧЕНИЕ:
//   Читает накладную поставщика (из XLS-файла или из текущего документа
//   «Поступление товаров и услуг» 1С) и создаёт документ прихода
//   (purchase_headers + purchase_items) в PostgreSQL-базе Vetais.
//
// ЛОГИКА СОПОСТАВЛЕНИЯ НОМЕНКЛАТУРЫ:
//   1. По штрихкоду (ean_code) — наиболее точный вариант
//   2. По внешнему коду 1С (stock_item.id_1c = код товара в 1С)
//   3. По точному наименованию (ILIKE)
//   Несопоставленные строки отображаются в таблице для ручной привязки.
//
// ВАЖНО:
//   • Остатки (stock_item_quantities) в Vetais обновляются не триггером,
//     а приложением при «проведении» документа. Поэтому после импорта
//     нужно войти в Vetais → Склад → Приходы и провести созданный документ
//     (или нажать кнопку «Подтвердить» в интерфейсе Vetais).
//   • Требуется psqlODBC на компьютере с 1С:
//     https://www.postgresql.org/ftp/odbc/versions/msi/
//
// =====================================================================
// КАК СОЗДАТЬ В КОНФИГУРАТОРЕ:
// 1. Файл → Новый → Внешняя обработка
// 2. Добавить форму (Основная: ДА)
//
// 3. Реквизиты формы:
//    Имя                    Тип                                 Длина
//    ──────────────────────────────────────────────────────────────────
//    ПодкХост               Строка                              100
//    ПодкПорт               Строка                              10
//    ПодкБаза               Строка                              100
//    ПодкПользователь       Строка                              50
//    ПодкПароль             Строка                              50
//    ВыбранныйФилиалИД      Строка                              50    ← clinic_id
//    ВыбранныйСкладИД       Строка                              50    ← id_stock
//    ВыбранныйСубъектИД     Строка                              50    ← id_subject (организация)
//    ВыбранныйПоставщикИД   Строка                              50    ← id_supplier
//    ВыбранныйФилиал        Строка                              200
//    ВыбранныйСклад         Строка                              200
//    ВыбранныйСубъект       Строка                              200
//    ВыбранныйПоставщик     Строка                              200
//    РежимЗагрузки          Строка                              10    ← "XLS" или "1С"
//    ПутьКФайлу             Строка                              500
//    НомерНакладной         Строка                              200
//    ДатаНакладной          Дата
//    НомерСчета             Строка                              200   ← no_evidence
//    НомерСтрокиНаименование Число                              2     ← строка заголовка XLS
//    НомерКолНаименование   Число                              2
//    НомерКолШтрихкод       Число                              2
//    НомерКолКоличество     Число                              2
//    НомерКолЕдиница        Число                              2
//    НомерКолЦенаБезНДС     Число                              2
//    НомерКолСтавкаНДС      Число                              2
//    НомерКолСуммаСНДС      Число                              2
//    НомерКолСерия          Число                              2
//    НомерКолСрокГодности   Число                              2
//    РезультатОтчета        Строка                              1000
//
// 4. Табличная часть формы «ТаблицаСтрок» с колонками:
//    НоменклатураНаименование  Строка  300
//    Штрихкод                  Строка  50
//    КодВетаис                 Строка  20   ← id_stock_item (заполняется автоматически или вручную)
//    НаименованиеВетаис        Строка  300
//    Количество                Число
//    ЕдиницаИзмерения          Строка  50
//    ЦенаБезНДС                Число
//    СтавкаНДС                 Строка  10
//    СуммаСНДС                 Число
//    Серия                     Строка  100
//    СрокГодности              Дата
//    Статус                    Строка  50   ← "Найден" / "НЕ НАЙДЕН" / "Ошибка"
//
// 5. Элементы формы:
//    ── Группа "Подключение к базе Vetais" ─────────────────────────────
//    [Поле ввода]   ПодкХост             "Хост (PostgreSQL)"
//    [Поле ввода]   ПодкПорт             "Порт"
//    [Поле ввода]   ПодкБаза             "База данных"
//    [Поле ввода]   ПодкПользователь     "Пользователь"
//    [Поле ввода]   ПодкПароль           "Пароль" (Режим пароля: Да)
//    [Кнопка]       команда ЗагрузитьСправочники  "Загрузить справочники"
//    ── Группа "Параметры документа" ───────────────────────────────────
//    [Поле выбора]  ВыбранныйФилиал      "Филиал (clinic_id)"
//       → ПриИзменении: ФилиалПриИзменении
//    [Поле выбора]  ВыбранныйСклад       "Склад (id_stock)"
//    [Поле выбора]  ВыбранныйСубъект     "Организация (our company)"
//    [Поле выбора]  ВыбранныйПоставщик   "Поставщик"
//    [Поле ввода]   НомерНакладной       "Номер накладной"
//    [Поле ввода]   НомерСчета           "Номер счёта / доп. номер"
//    [Поле даты]    ДатаНакладной        "Дата накладной"
//    ── Группа "Источник данных" ────────────────────────────────────────
//    [Переключатель] РежимЗагрузки = "XLS" | "1С"
//    [Поле ввода]   ПутьКФайлу           "Путь к XLS-файлу"
//    [Кнопка]       команда ВыбратьФайл  "Выбрать..."
//    ── Группа "Колонки XLS" (видна только при РежимЗагрузки=XLS) ──────
//    [Поле числа]   НомерСтрокиНаименование   "Строка заголовка"
//    [Поле числа]   НомерКолНаименование      "Кол. «Наименование»"
//    [Поле числа]   НомерКолШтрихкод          "Кол. «Штрихкод»"
//    [Поле числа]   НомерКолКоличество        "Кол. «Количество»"
//    [Поле числа]   НомерКолЕдиница           "Кол. «Ед. изм.»"
//    [Поле числа]   НомерКолЦенаБезНДС        "Кол. «Цена без НДС»"
//    [Поле числа]   НомерКолСтавкаНДС         "Кол. «Ставка НДС %»"
//    [Поле числа]   НомерКолСуммаСНДС         "Кол. «Сумма с НДС»"
//    [Поле числа]   НомерКолСерия             "Кол. «Серия/партия»"
//    [Поле числа]   НомерКолСрокГодности      "Кол. «Срок годности»"
//    ── Таблица строк ───────────────────────────────────────────────────
//    [Таблица]      ТаблицаСтрок        (все колонки из реквизита ТЧ)
//    [Кнопка]       команда ЗагрузитьСтроки   "Загрузить строки"
//    [Кнопка]       команда СопоставитьНоменклатуру "Сопоставить с Vetais"
//    [Кнопка]       команда СоздатьДокументВВетаис  "Создать документ в Vetais" (основная)
//    [Поле текста многострочное] РезультатОтчета (ТолькоПросмотр)
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Значения по умолчанию
    ПодкХост           = "109.173.124.18";
    ПодкПорт           = "5454";
    ПодкБаза           = "vetais";
    ПодкПользователь   = "postgres";
    ПодкПароль         = "vetais";
    ДатаНакладной      = ТекущаяДата();
    РежимЗагрузки      = "XLS";

    // Номера колонок XLS по умолчанию (типичный формат накладной поставщика)
    НомерСтрокиНаименование = 1;   // строка заголовков
    НомерКолНаименование    = 1;
    НомерКолШтрихкод        = 2;
    НомерКолКоличество      = 3;
    НомерКолЕдиница         = 4;
    НомерКолЦенаБезНДС      = 5;
    НомерКолСтавкаНДС       = 6;
    НомерКолСуммаСНДС       = 7;
    НомерКолСерия           = 8;
    НомерКолСрокГодности    = 9;

    ЗагрузитьНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьСправочники(Команда)
    РезультатОтчета = "";
    ЗагрузитьСправочникиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайл(Команда)
    ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    ДиалогВыбораФайла.Фильтр       = "Excel файлы (*.xls;*.xlsx)|*.xls;*.xlsx|Все файлы (*.*)|*.*";
    ДиалогВыбораФайла.МножественныйВыбор = Ложь;
    ДиалогВыбораФайла.Заголовок    = "Выберите файл накладной";
    Если ДиалогВыбораФайла.Выбрать() Тогда
        ПутьКФайлу = ДиалогВыбораФайла.ПолноеИмяФайла;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтроки(Команда)
    РезультатОтчета = "";
    ТаблицаСтрок.Очистить();
    ЗагрузитьСтрокиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СопоставитьНоменклатуру(Команда)
    РезультатОтчета = "";
    СопоставитьНоменклатуруНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументВВетаис(Команда)
    // Проверка обязательных полей
    Если ПустаяСтрока(ВыбранныйФилиалИД) Тогда
        Предупреждение("Выберите филиал!");
        Возврат;
    КонецЕсли;
    Если ПустаяСтрока(ВыбранныйСкладИД) Тогда
        Предупреждение("Выберите склад!");
        Возврат;
    КонецЕсли;
    Если ПустаяСтрока(НомерНакладной) Тогда
        Предупреждение("Введите номер накладной!");
        Возврат;
    КонецЕсли;
    Если ТаблицаСтрок.Количество() = 0 Тогда
        Предупреждение("Загрузите строки накладной!");
        Возврат;
    КонецЕсли;
    // Проверить несопоставленные строки
    НесопоставленоКол = 0;
    Для Каждого Стр Из ТаблицаСтрок Цикл
        Если ПустаяСтрока(Стр.КодВетаис) Тогда
            НесопоставленоКол = НесопоставленоКол + 1;
        КонецЕсли;
    КонецЦикла;
    Если НесопоставленоКол > 0 Тогда
        Ответ = Вопрос(
            "Внимание! " + НесопоставленоКол + " строк не сопоставлены с номенклатурой Vetais." + Символы.ПС +
            "Эти строки будут пропущены." + Символы.ПС +
            "Продолжить создание документа?",
            РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет
        );
        Если Ответ <> КодВозвратаДиалога.Да Тогда
            Возврат;
        КонецЕсли;
    КонецЕсли;
    РезультатОтчета = "";
    СоздатьДокументВВетаисНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФилиалПриИзменении(Элемент)
    // При смене филиала можно автоматически выбрать склад
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиНаСервере

&НаСервере
Процедура ЗагрузитьСправочникиНаСервере()
    Попытка
        Соединение = ПолучитьОДБК_Соединение();

        // ── Загрузить филиалы (file_clinics) ──
        РезФилиалы = ВыполнитьЗапрос(Соединение, "
            SELECT id, name FROM file_clinics WHERE deleted IS DISTINCT FROM 1 ORDER BY name
        ");
        СписокФилиалов = ПолучитьРеквизитФормыПоИмени(ЭтотОбъект, "ВыбранныйФилиал");
        СписокФилиалов.ОчиститьСписокВыбора();
        Пока РезФилиалы.Следующий() Цикл
            СписокФилиалов.СписокВыбора.Добавить(
                Строка(РезФилиалы["id"]),
                Строка(РезФилиалы["name"])
            );
        КонецЦикла;

        // ── Загрузить склады ──
        РезСклады = ВыполнитьЗапрос(Соединение, "
            SELECT s.id, s.name
            FROM eco_stock s
            WHERE s.deleted IS DISTINCT FROM 1
            ORDER BY s.name
        ");
        СписокСкладов = ПолучитьРеквизитФормыПоИмени(ЭтотОбъект, "ВыбранныйСклад");
        СписокСкладов.ОчиститьСписокВыбора();
        Пока РезСклады.Следующий() Цикл
            СписокСкладов.СписокВыбора.Добавить(
                Строка(РезСклады["id"]),
                Строка(РезСклады["name"])
            );
        КонецЦикла;

        // ── Загрузить субъекты (организации/поставщики) ──
        РезСубъекты = ВыполнитьЗапрос(Соединение, "
            SELECT id, name, code FROM list_subject
            WHERE deleted IS DISTINCT FROM 1
            ORDER BY name
        ");
        СписокСубъекты  = ПолучитьРеквизитФормыПоИмени(ЭтотОбъект, "ВыбранныйСубъект");
        СписокПоставщик = ПолучитьРеквизитФормыПоИмени(ЭтотОбъект, "ВыбранныйПоставщик");
        СписокСубъекты.ОчиститьСписокВыбора();
        СписокПоставщик.ОчиститьСписокВыбора();
        Пока РезСубъекты.Следующий() Цикл
            СписокСубъекты.СписокВыбора.Добавить(
                Строка(РезСубъекты["id"]),
                Строка(РезСубъекты["name"])
            );
            СписокПоставщик.СписокВыбора.Добавить(
                Строка(РезСубъекты["id"]),
                Строка(РезСубъекты["name"])
            );
        КонецЦикла;

        ЗакрытьСоединение(Соединение);
        РезультатОтчета = "✅ Справочники загружены успешно";
        СохранитьНастройки();
    Исключение
        РезультатОтчета = "❌ Ошибка загрузки справочников: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСтрокиНаСервере()
    Если РежимЗагрузки = "XLS" Тогда
        ЗагрузитьИзXLS();
    ИначеЕсли РежимЗагрузки = "1С" Тогда
        ЗагрузитьИз1СДокумента();
    Иначе
        РезультатОтчета = "❌ Неизвестный режим загрузки";
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзXLS()
    Если ПустаяСтрока(ПутьКФайлу) Тогда
        РезультатОтчета = "❌ Укажите путь к XLS-файлу";
        Возврат;
    КонецЕсли;
    Попытка
        Excel = Новый COMОбъект("Excel.Application");
        Excel.Visible = Ложь;
        Excel.DisplayAlerts = Ложь;
        Книга = Excel.Workbooks.Open(ПутьКФайлу);
        Лист  = Книга.Sheets(1);

        ПоследняяСтрока = Лист.UsedRange.Rows.Count;
        НачальнаяСтрока = НомерСтрокиНаименование + 1; // после заголовка

        КолЗагружено = 0;
        Для НомСтр = НачальнаяСтрока По ПоследняяСтрока Цикл
            Наименование = Строка(Лист.Cells(НомСтр, НомерКолНаименование).Value);
            Если ПустаяСтрока(Наименование) Тогда
                Продолжить;
            КонецЕсли;

            НоваяСтрока = ТаблицаСтрок.Добавить();
            НоваяСтрока.НоменклатураНаименование = Наименование;

            Если НомерКолШтрихкод > 0 Тогда
                НоваяСтрока.Штрихкод = Строка(Лист.Cells(НомСтр, НомерКолШтрихкод).Value);
            КонецЕсли;
            Если НомерКолКоличество > 0 Тогда
                НоваяСтрока.Количество = Число(Строка(Лист.Cells(НомСтр, НомерКолКоличество).Value));
            КонецЕсли;
            Если НомерКолЕдиница > 0 Тогда
                НоваяСтрока.ЕдиницаИзмерения = Строка(Лист.Cells(НомСтр, НомерКолЕдиница).Value);
            КонецЕсли;
            Если НомерКолЦенаБезНДС > 0 Тогда
                НоваяСтрока.ЦенаБезНДС = Число(Строка(Лист.Cells(НомСтр, НомерКолЦенаБезНДС).Value));
            КонецЕсли;
            Если НомерКолСтавкаНДС > 0 Тогда
                НоваяСтрока.СтавкаНДС = Строка(Лист.Cells(НомСтр, НомерКолСтавкаНДС).Value);
            КонецЕсли;
            Если НомерКолСуммаСНДС > 0 Тогда
                НоваяСтрока.СуммаСНДС = Число(Строка(Лист.Cells(НомСтр, НомерКолСуммаСНДС).Value));
            КонецЕсли;
            Если НомерКолСерия > 0 Тогда
                НоваяСтрока.Серия = Строка(Лист.Cells(НомСтр, НомерКолСерия).Value);
            КонецЕсли;
            Если НомерКолСрокГодности > 0 Тогда
                ЗначениеСрока = Лист.Cells(НомСтр, НомерКолСрокГодности).Value;
                Если ЗначениеСрока <> Неопределено И ЗначениеСрока <> "" Тогда
                    Попытка
                        НоваяСтрока.СрокГодности = Дата(Строка(ЗначениеСрока));
                    Исключение
                        НоваяСтрока.СрокГодности = '00010101'; // пустая дата
                    КонецПопытки;
                КонецЕсли;
            КонецЕсли;

            НоваяСтрока.Статус = "Не сопоставлен";
            КолЗагружено = КолЗагружено + 1;
        КонецЦикла;

        Книга.Close(Ложь);
        Excel.Quit();
        Excel = Неопределено;

        РезультатОтчета = "✅ Загружено строк из XLS: " + КолЗагружено;
    Исключение
        РезультатОтчета = "❌ Ошибка чтения XLS: " + ОписаниеОшибки();
        Попытка
            Книга.Close(Ложь);
            Excel.Quit();
        Исключение
        КонецПопытки;
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИз1СДокумента()
    // Читает строки из последнего открытого документа «Поступление товаров и услуг»
    Попытка
        Выборка = Документы.ПоступлениеТоваровУслуг.Выбрать(,, Новый СтандартнаяДатаНачала(), ТекущаяДата());
        ДокументНайден = Ложь;
        Пока Выборка.Следующий() Цикл
            ДокументОбъект = Выборка.ПолучитьОбъект();
            ДокументНайден = Истина;
            Прервать;
        КонецЦикла;

        Если Не ДокументНайден Тогда
            РезультатОтчета = "❌ Не найден документ «Поступление товаров и услуг»." + Символы.ПС +
                "Откройте нужный документ в 1С и повторите.";
            Возврат;
        КонецЕсли;

        // Заполнить реквизиты шапки из документа
        НомерНакладной = Строка(ДокументОбъект.НомерВходящегоДокумента);
        Если НЕ ЗначениеЗаполнено(ДатаНакладной) Тогда
            ДатаНакладной = ДокументОбъект.Дата;
        КонецЕсли;

        КолЗагружено = 0;
        Для Каждого СтрТЧ Из ДокументОбъект.Товары Цикл
            Наименование = Строка(СтрТЧ.Номенклатура.Наименование);
            Если ПустаяСтрока(Наименование) Тогда
                Продолжить;
            КонецЕсли;
            НоваяСтрока = ТаблицаСтрок.Добавить();
            НоваяСтрока.НоменклатураНаименование = Наименование;
            НоваяСтрока.Штрихкод                 = Строка(СтрТЧ.Номенклатура.Штрихкод);
            НоваяСтрока.Количество               = СтрТЧ.Количество;
            НоваяСтрока.ЕдиницаИзмерения         = Строка(СтрТЧ.ЕдиницаИзмерения.Наименование);
            НоваяСтрока.ЦенаБезНДС               = СтрТЧ.Цена;
            НоваяСтрока.СтавкаНДС                = Строка(СтрТЧ.СтавкаНДС);
            НоваяСтрока.СуммаСНДС                = СтрТЧ.Сумма;
            НоваяСтрока.Серия                    = Строка(СтрТЧ.СерияНоменклатуры);
            НоваяСтрока.Статус                   = "Не сопоставлен";
            КолЗагружено = КолЗагружено + 1;
        КонецЦикла;

        РезультатОтчета = "✅ Загружено строк из документа 1С: " + КолЗагружено;
    Исключение
        РезультатОтчета = "❌ Ошибка чтения документа 1С: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СопоставитьНоменклатуруНаСервере()
    Если ТаблицаСтрок.Количество() = 0 Тогда
        РезультатОтчета = "❌ Сначала загрузите строки накладной";
        Возврат;
    КонецЕсли;

    Попытка
        Соединение = ПолучитьОДБК_Соединение();

        // Загружаем всю номенклатуру Vetais в память для быстрого поиска
        НоменклатураВетаис = Новый ТаблицаЗначений();
        НоменклатураВетаис.Колонки.Добавить("id",         Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(30)));
        НоменклатураВетаис.Колонки.Добавить("name",       Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(500)));
        НоменклатураВетаис.Колонки.Добавить("ean_code",   Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
        НоменклатураВетаис.Колонки.Добавить("code",       Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
        НоменклатураВетаис.Колонки.Добавить("id_1c",      Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
        НоменклатураВетаис.Колонки.Добавить("unit_purchase_id", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
        НоменклатураВетаис.Колонки.Добавить("unit_sale_id",     Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
        НоменклатураВетаис.Колонки.Добавить("vat_purchase_id",  Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));

        РезНом = ВыполнитьЗапрос(Соединение, "
            SELECT id, name, ean_code, code, id_1c,
                   unit_purchase_id, unit_sale_id, vat_purchase_id
            FROM stock_item
            WHERE deleted IS DISTINCT FROM 1
        ");
        Пока РезНом.Следующий() Цикл
            НовСтр = НоменклатураВетаис.Добавить();
            НовСтр.id               = Строка(РезНом["id"]);
            НовСтр.name             = НРег(Строка(РезНом["name"]));
            НовСтр.ean_code         = Строка(РезНом["ean_code"]);
            НовСтр.code             = Строка(РезНом["code"]);
            НовСтр.id_1c            = Строка(РезНом["id_1c"]);
            НовСтр.unit_purchase_id = Строка(РезНом["unit_purchase_id"]);
            НовСтр.unit_sale_id     = Строка(РезНом["unit_sale_id"]);
            НовСтр.vat_purchase_id  = Строка(РезНом["vat_purchase_id"]);
        КонецЦикла;

        // Загрузить единицы измерения Vetais
        ЕдиницыВетаис = Новый Соответствие();
        РезЕд = ВыполнитьЗапрос(Соединение, "SELECT id, name FROM pricelist_units ORDER BY id");
        Пока РезЕд.Следующий() Цикл
            ЕдиницыВетаис.Вставить(НРег(Строка(РезЕд["name"])), Строка(РезЕд["id"]));
        КонецЦикла;

        // Загрузить ставки НДС Vetais
        НДСВетаис = Новый Соответствие(); // "0" → id, "10" → id, "18" → id
        РезНДС = ВыполнитьЗапрос(Соединение, "SELECT id, name, perc FROM pricelist_vat ORDER BY id");
        Пока РезНДС.Следующий() Цикл
            НДСВетаис.Вставить(Строка(РезНДС["perc"]), Строка(РезНДС["id"]));
        КонецЦикла;

        ЗакрытьСоединение(Соединение);

        НайденоКол     = 0;
        НеНайденоКол   = 0;

        Для Каждого Стр Из ТаблицаСтрок Цикл
            // Пропускаем уже сопоставленные вручную
            Если НЕ ПустаяСтрока(Стр.КодВетаис) Тогда
                Продолжить;
            КонецЕсли;

            НайдСтроки = Неопределено;

            // 1. Поиск по штрихкоду
            Если НЕ ПустаяСтрока(Стр.Штрихкод) Тогда
                НайдСтроки = НоменклатураВетаис.НайтиСтроки(Новый Структура("ean_code", СокрЛП(Стр.Штрихкод)));
            КонецЕсли;

            // 2. Поиск по коду 1С (id_1c)
            Если (НайдСтроки = Неопределено ИЛИ НайдСтроки.Количество() = 0) Тогда
                // Получить код 1С текущей номенклатуры (из текущего документа 1С)
                КодВетаиса1С = "";
                // Попытка найти по совпадению name (ILIKE)
                НаимНРег = НРег(СокрЛП(Стр.НоменклатураНаименование));
                НайдСтроки = НоменклатураВетаис.НайтиСтроки(Новый Структура("name", НаимНРег));
            КонецЕсли;

            // 3. Нечёткий поиск — ищем вхождение первых 30 символов
            Если НайдСтроки = Неопределено ИЛИ НайдСтроки.Количество() = 0 Тогда
                ЧастьНаим = Лев(НРег(СокрЛП(Стр.НоменклатураНаименование)), 30);
                НайдСтроки = Новый Массив();
                Для Каждого НомСтр Из НоменклатураВетаис Цикл
                    Если Найти(НомСтр.name, ЧастьНаим) > 0 Тогда
                        НайдСтроки.Добавить(НомСтр);
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;

            Если НайдСтроки <> Неопределено И НайдСтроки.Количество() > 0 Тогда
                НайдСтр = НайдСтроки[0];
                Стр.КодВетаис         = НайдСтр.id;
                Стр.НаименованиеВетаис = НайдСтр.name;
                Стр.Статус            = "Найден";
                НайденоКол = НайденоКол + 1;
            Иначе
                Стр.Статус = "НЕ НАЙДЕН";
                НеНайденоКол = НеНайденоКол + 1;
            КонецЕсли;
        КонецЦикла;

        РезультатОтчета = "✅ Сопоставление завершено." + Символы.ПС +
            "   Найдено:        " + НайденоКол + Символы.ПС +
            "   Не найдено:     " + НеНайденоКол + Символы.ПС +
            "Несопоставленные строки — заполните колонку «КодВетаис» вручную (id из stock_item).";
    Исключение
        РезультатОтчета = "❌ Ошибка сопоставления: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументВВетаисНаСервере()
    Попытка
        Соединение = ПолучитьОДБК_Соединение();

        // ── Получить следующий id для purchase_headers ──
        РезИД = ВыполнитьЗапрос(Соединение, "SELECT nextval('purchase_headers_id_seq') AS new_id");
        НовыйИД_Заголовка = Строка(РезИД["new_id"]);

        // ── Сформировать no_number ──
        НомерДок = СокрЛП(НомерНакладной);
        ДатаДок  = Формат(ДатаНакладной, "ДФ=dd.MM.yyyy");

        // ── Определить сумму всего документа ──
        ИтогоСНДС = 0;
        Для Каждого Стр Из ТаблицаСтрок Цикл
            Если НЕ ПустаяСтрока(Стр.КодВетаис) Тогда
                ИтогоСНДС = ИтогоСНДС + Стр.СуммаСНДС;
            КонецЕсли;
        КонецЦикла;

        // ── Вставка purchase_headers ──
        ДатаДокSQL      = Формат(ДатаНакладной, "ДФ=yyyy-MM-dd");
        ИД_Клиники      = ВыбранныйФилиалИД;
        ИД_Склада       = ВыбранныйСкладИД;
        ИД_Субъекта     = ?(ПустаяСтрока(ВыбранныйСубъектИД), "NULL", ВыбранныйСубъектИД);
        ИД_Поставщика   = ?(ПустаяСтрока(ВыбранныйПоставщикИД), "NULL", ВыбранныйПоставщикИД);
        НомДоп          = СокрЛП(НомерСчета);

        ТекстINSERT = "
            INSERT INTO purchase_headers (
                id, id_type, id_state, dt_when, id_subject, id_supplier,
                no_number, no_evidence, sum_price_vat, id_currency,
                id_stock, deleted, clinic_id, dt_created, user_id,
                show_all_methods, from_sbs
            ) VALUES (
                " + НовыйИД_Заголовка + ",
                1,
                1,
                '" + ДатаДокSQL + "',
                " + ИД_Субъекта + ",
                " + ИД_Поставщика + ",
                '" + Экранировать(НомерДок) + "',
                '" + Экранировать(НомДоп)   + "',
                " + Формат(ИтогоСНДС, "ЧРД=.; ЧН=0") + ",
                1,
                " + ИД_Склада + ",
                0,
                " + ИД_Клиники + ",
                NOW(),
                0,
                0,
                0
            )
        ";

        ВыполнитьЗапрос(Соединение, ТекстINSERT);

        // ── Вставка строк purchase_items ──
        СтрокВставлено   = 0;
        СтрокПропущено   = 0;
        СтрокОшибок      = 0;

        Для Каждого Стр Из ТаблицаСтрок Цикл
            Если ПустаяСтрока(Стр.КодВетаис) Тогда
                СтрокПропущено = СтрокПропущено + 1;
                Продолжить;
            КонецЕсли;

            Попытка
                // Следующий id для purchase_items
                РезИДСтр = ВыполнитьЗапрос(Соединение, "SELECT nextval('purchase_items_id_seq') AS new_id");
                НовыйИД_Стр = Строка(РезИДСтр["new_id"]);

                // Разбор ставки НДС
                ПроцентНДС = СокрЛП(Стр.СтавкаНДС);
                ПроцентНДС = СтрЗаменить(ПроцентНДС, "%", "");
                ПроцентНДС = СтрЗаменить(ПроцентНДС, " ", "");
                Если ПроцентНДС = "БезНДС" ИЛИ ПроцентНДС = "0" ИЛИ ПустаяСтрока(ПроцентНДС) Тогда
                    ИД_НДС   = "1";   // 0%
                    ИмяНДС   = "0";
                ИначеЕсли ПроцентНДС = "10" Тогда
                    ИД_НДС   = "2";
                    ИмяНДС   = "10";
                ИначеЕсли ПроцентНДС = "18" ИЛИ ПроцентНДС = "20" Тогда
                    ИД_НДС   = "3";
                    ИмяНДС   = "18";
                Иначе
                    ИД_НДС   = "1";
                    ИмяНДС   = "0";
                КонецЕсли;

                // Расчёт суммы без НДС
                СуммаСНДС   = Стр.СуммаСНДС;
                ЦенаЕдБезНДС = Стр.ЦенаБезНДС;
                Количество  = Стр.Количество;
                Если Количество = 0 Тогда Количество = 1 КонецЕсли;
                СуммаБезНДС = ?(ЦенаЕдБезНДС > 0, ЦенаЕдБезНДС * Количество, СуммаСНДС);
                СуммаНДС    = СуммаСНДС - СуммаБезНДС;

                // Единица измерения — берём name от stock_item из Vetais
                ИД_ЕдИзм = "3"; // по умолчанию шт
                ИмяЕдИзм = СокрЛП(Стр.ЕдиницаИзмерения);

                // Срок годности
                СрокГодSQL = "NULL";
                Если Стр.СрокГодности <> '00010101' И Стр.СрокГодности <> Дата(1, 1, 1) Тогда
                    СрокГодSQL = "'" + Формат(Стр.СрокГодности, "ДФ=yyyy-MM-dd") + "'";
                КонецЕсли;

                // Серия/партия
                СерияSQL = "'" + Экранировать(Стр.Серия) + "'";

                // Название товара для хранения в таблице
                НазваниеТовара = Экранировать(Стр.НоменклатураНаименование);
                Если НЕ ПустаяСтрока(Стр.НаименованиеВетаис) Тогда
                    НазваниеТовара = Экранировать(Стр.НаименованиеВетаис);
                КонецЕсли;

                ТекстINSERTСтр = "
                    INSERT INTO purchase_items (
                        id, purchase_header_id, id_stock_item,
                        sarze, dt_expiration,
                        amount, price_unit, price, price_vat, price_with_vat,
                        dt_created, deleted, id_stock, clinic_id,
                        purchase_status_id, create_status,
                        vat_purchase_id, vat_purchase_name,
                        unit_purchase_id, unit_purchase_name,
                        unit_sale_id, unit_sale_name,
                        stock_item_name
                    ) VALUES (
                        " + НовыйИД_Стр + ",
                        " + НовыйИД_Заголовка + ",
                        " + Стр.КодВетаис + ",
                        " + СерияSQL + ",
                        " + СрокГодSQL + ",
                        " + Формат(Количество,  "ЧРД=.; ЧН=0") + ",
                        " + Формат(ЦенаЕдБезНДС, "ЧРД=.; ЧН=0") + ",
                        " + Формат(СуммаБезНДС,  "ЧРД=.; ЧН=0") + ",
                        " + Формат(СуммаНДС,     "ЧРД=.; ЧН=0") + ",
                        " + Формат(СуммаСНДС,    "ЧРД=.; ЧН=0") + ",
                        NOW(),
                        0,
                        " + ИД_Склада + ",
                        " + ИД_Клиники + ",
                        1,
                        1,
                        " + ИД_НДС + ",
                        '" + ИмяНДС + "',
                        " + ИД_ЕдИзм + ",
                        '" + Экранировать(ИмяЕдИзм) + "',
                        " + ИД_ЕдИзм + ",
                        '" + Экранировать(ИмяЕдИзм) + "',
                        '" + НазваниеТовара + "'
                    )
                ";

                ВыполнитьЗапрос(Соединение, ТекстINSERTСтр);
                СтрокВставлено = СтрокВставлено + 1;
            Исключение
                СтрокОшибок = СтрокОшибок + 1;
            КонецПопытки;
        КонецЦикла;

        ЗакрытьСоединение(Соединение);

        РезультатОтчета =
            "✅ ДОКУМЕНТ СОЗДАН В VETAIS" + Символы.ПС +
            "   ID документа:   " + НовыйИД_Заголовка + Символы.ПС +
            "   Номер:          " + НомерДок + Символы.ПС +
            "   Дата:           " + ДатаДок  + Символы.ПС +
            "   Строк добавлено:" + СтрокВставлено + Символы.ПС +
            "   Строк пропущено:" + СтрокПропущено + Символы.ПС +
            "   Строк ошибок:   " + СтрокОшибок + Символы.ПС + Символы.ПС +
            "⚠️  Для зачисления на склад войдите в Vetais → Склад → Приходы" + Символы.ПС +
            "   и подтвердите (проведите) документ № " + НовыйИД_Заголовка;
    Исключение
        РезультатОтчета = "❌ Ошибка создания документа: " + ОписаниеОшибки();
        Попытка ЗакрытьСоединение(Соединение); Исключение КонецПопытки;
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеФункции_ОДБК

// Возвращает активное ODBC-соединение с базой Vetais (PostgreSQL)
&НаСервере
Функция ПолучитьОДБК_Соединение()
    СтрПодкл =
        "Driver={PostgreSQL Unicode};"           +
        "Server="   + СокрЛП(ПодкХост) + ";"   +
        "Port="     + СокрЛП(ПодкПорт) + ";"   +
        "Database=" + СокрЛП(ПодкБаза) + ";"   +
        "Uid="      + СокрЛП(ПодкПользователь) + ";" +
        "Pwd="      + СокрЛП(ПодкПароль) + ";" +
        "Client_Encoding=UTF8;"                  +
        "UseUnicode=True;"                       +
        "BoolsAsChar=0;";

    ADO = Новый COMОбъект("ADODB.Connection");
    ADO.ConnectionString = СтрПодкл;
    ADO.Open();
    Возврат ADO;
КонецФункции

// Выполняет SQL-запрос через ADODB; возвращает RecordSet
&НаСервере
Функция ВыполнитьЗапрос(Соединение, ТекстSQL)
    RS = Соединение.Execute(ТекстSQL);
    Возврат RS;
КонецФункции

// Закрывает соединение
&НаСервере
Процедура ЗакрытьСоединение(Соединение)
    Попытка
        Если Соединение.State <> 0 Тогда
            Соединение.Close();
        КонецЕсли;
    Исключение
    КонецПопытки;
КонецПроцедуры

// Экранирует одиночные кавычки для вставки в SQL-строку
&НаСервере
Функция Экранировать(Знач Стр)
    Возврат СтрЗаменить(Строка(Стр), "'", "''");
КонецФункции

#КонецОбласти

#Область НастройкиПользователя

&НаСервере
Процедура СохранитьНастройки()
    ХранилищеОбщихНастроек.Сохранить("VetaisNakl", "Хост",       ПодкХост);
    ХранилищеОбщихНастроек.Сохранить("VetaisNakl", "Порт",       ПодкПорт);
    ХранилищеОбщихНастроек.Сохранить("VetaisNakl", "База",       ПодкБаза);
    ХранилищеОбщихНастроек.Сохранить("VetaisNakl", "Польз",      ПодкПользователь);
    ХранилищеОбщихНастроек.Сохранить("VetaisNakl", "Пароль",     ПодкПароль);
КонецПроцедуры

