// =====================================================================
// ВНЕШНЯЯ ОБРАБОТКА 1С: Отчёт о розничных продажах из Vetais
// v4.0
// Логика:
//   • Каждый чек (accounts_headers) → отдельная строка в документе
//   • Наименование в каждой строке = "Ветеринарные услуги" (одна номенклатура)
//   • Сумма строки = сумма позиций чека (accounts_items)
//   • Безналичные оплаты → вкладка "Безналичные оплаты" документа
// =====================================================================
//
// КАК СОЗДАТЬ В КОНФИГУРАТОРЕ:
// 1. Файл → Новый → Внешняя обработка
// 2. Добавить форму (Основная: ДА)
//
// 3. Реквизиты формы:
//    Имя                    Тип                         Длина
//    ─────────────────────────────────────────────────────────
//    ПодкХост               Строка                      100
//    ПодкПорт               Строка                      10
//    ПодкБаза               Строка                      100
//    ПодкПользователь       Строка                      50
//    ПодкПароль             Строка                      50
//    ВыбранныйФилиалИД      Строка                      50
//    ВыбранныйФилиал        Строка                      200
//    ИДБезналОплаты         Строка                      50   ← ID типа безнала в Vetais
//    ДатаС                  Дата
//    ДатаПо                 Дата
//    Организация            СправочникСсылка.Организации
//    Склад                  СправочникСсылка.Склады
//    Номенклатура           СправочникСсылка.Номенклатура  ← "Ветеринарные услуги"
//    СтавкаНДС              ПеречислениеСсылка.СтавкиНДС
//    ВидОплатыБезнал        СправочникСсылка.ВидыОплат     ← вид безнал. оплаты из 1С
//    РезультатОтчета        Строка(500)
//
// 4. Элементы формы:
//    ── Группа "Подключение к базе Vetais" ───────────────────────
//    [Поле ввода]  ПодкХост              "Хост"
//    [Поле ввода]  ПодкПорт              "Порт"
//    [Поле ввода]  ПодкБаза              "База данных"
//    [Поле ввода]  ПодкПользователь      "Пользователь"
//    [Поле ввода]  ПодкПароль            "Пароль" (Режим пароля: Да)
//    [Кнопка]      команда ЗагрузитьФилиалы   "Загрузить филиалы"
//    ── Группа "Фильтр" ──────────────────────────────────────────
//    [Поле выбора] ВыбранныйФилиал       "Филиал"
//      → ПриИзменении: ФилиалПриИзменении
//    [Поле даты]   ДатаС                 "Период с"
//    [Поле даты]   ДатаПо                "по"
//    ── Группа "Параметры документа 1С" ──────────────────────────
//    [Поле выбора] Организация           "Организация"
//    [Поле выбора] Склад                 "Склад"
//    [Поле выбора] Номенклатура          "Номенклатура (Ветеринарные услуги)"
//    [Поле выбора] СтавкаНДС             "Ставка НДС"
//    [Поле выбора] ВидОплатыБезнал       "Вид безнал. оплаты (для вкладки)"
//    [Поле ввода]  ИДБезналОплаты        "ID безнал. оплаты в Vetais (0=не определять)"
//    ─────────────────────────────────────────────────────────────
//    [Кнопка]  команда СформироватьОтчет "Создать документ в 1С"
//    [Поле текста] РезультатОтчета  "Результат" (ТолькоПросмотр)
//
// ПРИМЕЧАНИЕ: Требуется psqlODBC на компьютере с 1С
//   Скачать: https://www.postgresql.org/ftp/odbc/versions/msi/
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаС         = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ДатаПо        = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	СтавкаНДС     = Перечисления.СтавкиНДС.БезНДС;
	ИДБезналОплаты = "0";
	Выборка = Справочники.Организации.Выбрать();
	Если Выборка.Следующий() Тогда Организация = Выборка.Ссылка; КонецЕсли;
	ЗагрузитьНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ── Загрузить список филиалов из Vetais ──────────────────────────
&НаКлиенте
Процедура ЗагрузитьФилиалы(Команда)
	Если ПустаяСтрока(ПодкХост) Или ПустаяСтрока(ПодкБаза) Тогда
		Сообщить("Заполните данные подключения!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Филиалы = ПолучитьФилиалыСервер(ПодкХост, ПодкПорт, ПодкБаза, ПодкПользователь, ПодкПароль);

	Если ТипЗнч(Филиалы) = Тип("Строка") Тогда
		Сообщить(Филиалы, СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Элементы.ВыбранныйФилиал.СписокВыбора.Очистить();
	Элементы.ВыбранныйФилиал.СписокВыбора.Добавить("", "— Все филиалы —");
	Для Каждого Ф Из Филиалы Цикл
		Элементы.ВыбранныйФилиал.СписокВыбора.Добавить(Ф.ИД, Ф.Название);
	КонецЦикла;

	// Восстановить ранее выбранный
	Если ПустаяСтрока(ВыбранныйФилиалИД) Тогда
		ВыбранныйФилиал = "— Все филиалы —";
	Иначе
		Для Каждого Эл Из Элементы.ВыбранныйФилиал.СписокВыбора Цикл
			Если Эл.Значение = ВыбранныйФилиалИД Тогда
				ВыбранныйФилиал = Эл.Представление; Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Сообщить("Загружено филиалов: " + Филиалы.Количество());
КонецПроцедуры

&НаКлиенте
Процедура ФилиалПриИзменении(Элемент)
	Для Каждого Эл Из Элементы.ВыбранныйФилиал.СписокВыбора Цикл
		Если Эл.Представление = ВыбранныйФилиал Тогда
			ВыбранныйФилиалИД = Эл.Значение; Возврат;
		КонецЕсли;
	КонецЦикла;
	ВыбранныйФилиалИД = "";
КонецПроцедуры

// ── Создать документ ──────────────────────────────────────────────
&НаКлиенте
Процедура СформироватьОтчет(Команда)
	Если ПустаяСтрока(ПодкХост) Или ПустаяСтрока(ПодкБаза) Тогда
		Сообщить("Заполните данные подключения!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаС) Или Не ЗначениеЗаполнено(ДатаПо) Тогда
		Сообщить("Укажите период!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Укажите организацию!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Сообщить("Укажите номенклатуру (Ветеринарные услуги)!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;

	РезультатОтчета = "Запрос к Vetais...";

	Результат = СоздатьДокументНаСервере(
		ПодкХост, ПодкПорт, ПодкБаза, ПодкПользователь, ПодкПароль,
		ВыбранныйФилиалИД, ИДБезналОплаты,
		ДатаС, КонецДня(ДатаПо),
		Организация, Склад,
		Номенклатура, СтавкаНДС, ВидОплатыБезнал);

	РезультатОтчета = Результат.Сообщение;

	Если Результат.Успех Тогда
		СохранитьНастройки();
		ПоказатьЗначение(, Результат.ДокументСсылка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область НастройкиХранилища

&НаСервере
Процедура ЗагрузитьНастройки()
	Попытка
		С = ХранилищеОбщихНастроек.Загрузить("VetaisRetailReport", "НастройкиV4");
		Если ТипЗнч(С) <> Тип("Структура") Тогда Возврат; КонецЕсли;
		Если С.Свойство("ПодкХост")          Тогда ПодкХост          = С.ПодкХост;          КонецЕсли;
		Если С.Свойство("ПодкПорт")          Тогда ПодкПорт          = С.ПодкПорт;          КонецЕсли;
		Если С.Свойство("ПодкБаза")          Тогда ПодкБаза          = С.ПодкБаза;          КонецЕсли;
		Если С.Свойство("ПодкПользователь")  Тогда ПодкПользователь  = С.ПодкПользователь;  КонецЕсли;
		Если С.Свойство("ПодкПароль")        Тогда ПодкПароль        = С.ПодкПароль;        КонецЕсли;
		Если С.Свойство("ВыбранныйФилиалИД") Тогда ВыбранныйФилиалИД = С.ВыбранныйФилиалИД; КонецЕсли;
		Если С.Свойство("ВыбранныйФилиал")   Тогда ВыбранныйФилиал   = С.ВыбранныйФилиал;   КонецЕсли;
		Если С.Свойство("ИДБезналОплаты")    Тогда ИДБезналОплаты    = С.ИДБезналОплаты;    КонецЕсли;
		Если С.Свойство("ДатаС")             Тогда ДатаС             = С.ДатаС;             КонецЕсли;
		Если С.Свойство("ДатаПо")            Тогда ДатаПо            = С.ДатаПо;            КонецЕсли;
		Если С.Свойство("Организация")       Тогда Организация       = С.Организация;       КонецЕсли;
		Если С.Свойство("Склад")             Тогда Склад             = С.Склад;             КонецЕсли;
		Если С.Свойство("Номенклатура")      Тогда Номенклатура      = С.Номенклатура;      КонецЕсли;
		Если С.Свойство("СтавкаНДС")         Тогда СтавкаНДС         = С.СтавкаНДС;         КонецЕсли;
		Если С.Свойство("ВидОплатыБезнал")   Тогда ВидОплатыБезнал   = С.ВидОплатыБезнал;   КонецЕсли;
	Исключение КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	С = Новый Структура;
	С.Вставить("ПодкХост",          ПодкХост);
	С.Вставить("ПодкПорт",          ПодкПорт);
	С.Вставить("ПодкБаза",          ПодкБаза);
	С.Вставить("ПодкПользователь",  ПодкПользователь);
	С.Вставить("ПодкПароль",        ПодкПароль);
	С.Вставить("ВыбранныйФилиалИД", ВыбранныйФилиалИД);
	С.Вставить("ВыбранныйФилиал",   ВыбранныйФилиал);
	С.Вставить("ИДБезналОплаты",    ИДБезналОплаты);
	С.Вставить("ДатаС",             ДатаС);
	С.Вставить("ДатаПо",            ДатаПо);
	С.Вставить("Организация",       Организация);
	С.Вставить("Склад",             Склад);
	С.Вставить("Номенклатура",      Номенклатура);
	С.Вставить("СтавкаНДС",        СтавкаНДС);
	С.Вставить("ВидОплатыБезнал",  ВидОплатыБезнал);
	ХранилищеОбщихНастроек.Сохранить("VetaisRetailReport", "НастройкиV4", С);
КонецПроцедуры

#КонецОбласти

#Область РаботаСБазойVetais

// ── Список филиалов (только с продажами) ─────────────────────────
&НаСервереБезКонтекста
Функция ПолучитьФилиалыСервер(Хост, Порт, База, Польз, Пароль)
	Попытка
		Conn = Новый COMОбъект("ADODB.Connection");
		Conn.ConnectionString = СтрокаПодключения(Хост, Порт, База, Польз, Пароль);
		Conn.CursorLocation = 3; Conn.Open();

		Cmd = Новый COMОбъект("ADODB.Command");
		Cmd.ActiveConnection = Conn;
		Cmd.CommandTimeout   = 30;
		Cmd.CommandText      =
			"SELECT c.id::text AS id, c.name FROM clinic c"
			+ " WHERE EXISTS ("
			+ "   SELECT 1 FROM accounts_headers ah"
			+ "   WHERE ah.clinic_id = c.id AND ah.deleted = 0)"
			+ " ORDER BY c.name";

		Rs = Cmd.Execute();
		Рез = Новый Массив;
		Пока Не Rs.EOF Цикл
			Стр = Новый Структура("ИД,Название",
				Rs.Fields.Item("id").Value,
				Rs.Fields.Item("name").Value);
			Рез.Добавить(Стр);
			Rs.MoveNext();
		КонецЦикла;
		Rs.Close(); Conn.Close();
		Возврат Рез;
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

// ── Получить чеки из Vetais (один чек = одна строка) ─────────────
&НаСервереБезКонтекста
Функция ПолучитьЧекиИзVetais(Хост, Порт, База, Польз, Пароль,
	ФилиалИД, ИДБезнала, ДатаОт, ДатаДо)

	ДатОт = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатДо = Формат(ДатаДо, "ДФ=yyyy-MM-dd");

	УслФилиал = ?(Не ПустаяСтрока(ФилиалИД),
		" AND ah.clinic_id = " + ФилиалИД, "");

	// Определяем тип оплаты: если колонка существует — используем,
	// иначе считаем всё наличными (is_cash = true)
	// Проверяем наличие колонки type_payment в accounts_headers
	SQLПроверка =
		"SELECT column_name FROM information_schema.columns"
		+ " WHERE table_name = 'accounts_headers'"
		+ "   AND column_name IN ('type_payment','payment_type_id','id_payment_type')";

	SQL =
		"SELECT"
		+ "  ah.id::text,"
		+ "  ah.datetime_create,"
		+ "  round(coalesce(SUM(ai.sum_with_vat), 0)::numeric, 2) AS total,"
		+ "  NULL::text AS payment_type_col"  // будет заменено ниже если колонка есть
		+ " FROM accounts_headers ah"
		+ " LEFT JOIN accounts_items ai"
		+ "   ON ai.account_header_id = ah.id AND ai.deleted = 0"
		+ " WHERE ah.deleted = 0"
		+ "   AND ah.datetime_create::date BETWEEN '" + ДатОт + "' AND '" + ДатДо + "'"
		+ УслФилиал
		+ " GROUP BY ah.id, ah.datetime_create"
		+ " HAVING coalesce(SUM(ai.sum_with_vat), 0) > 0"
		+ " ORDER BY ah.datetime_create";

	Рез = Новый Структура("Успех,Чеки,Ошибка", Ложь, Новый Массив, "");
	Попытка
		Conn = Новый COMОбъект("ADODB.Connection");
		Conn.ConnectionString = СтрокаПодключения(Хост, Порт, База, Польз, Пароль);
		Conn.CursorLocation = 3; Conn.Open();

		// Проверить наличие колонки типа оплаты
		КолонкаОплаты = "";
		Cmd0 = Новый COMОбъект("ADODB.Command");
		Cmd0.ActiveConnection = Conn; Cmd0.CommandText = SQLПроверка;
		Rs0 = Cmd0.Execute();
		Если Не Rs0.EOF Тогда
			КолонкаОплаты = Rs0.Fields.Item("column_name").Value;
		КонецЕсли;
		Rs0.Close();

		// Скорректировать запрос если колонка найдена
		Если Не ПустаяСтрока(КолонкаОплаты) Тогда
			SQL = СтрЗаменить(SQL,
				"NULL::text AS payment_type_col",
				"ah." + КолонкаОплаты + "::text AS payment_type_col");
		КонецЕсли;

		Cmd = Новый COMОбъект("ADODB.Command");
		Cmd.ActiveConnection = Conn;
		Cmd.CommandText      = SQL;
		Cmd.CommandTimeout   = 120;

		Rs = Cmd.Execute();
		Пока Не Rs.EOF Цикл
			Сумма      = Rs.Fields.Item("total").Value;
			ТипОплаты = Rs.Fields.Item("payment_type_col").Value;

			// Безнал: если ИДБезнала задан и совпадает
			ЭтоБезнал = (Не ПустаяСтрока(ИДБезнала))
				И (ИДБезнала <> "0")
				И (ТипЗнч(ТипОплаты) <> Тип("Null"))
				И (Строка(ТипОплаты) = ИДБезнала);

			Чек = Новый Структура("Сумма,ЭтоБезнал", Сумма, ЭтоБезнал);
			Рез.Чеки.Добавить(Чек);
			Rs.MoveNext();
		КонецЦикла;
		Rs.Close(); Conn.Close();
		Рез.Успех = Истина;
	Исключение
		Рез.Ошибка = "ОШИБКА ПОДКЛЮЧЕНИЯ К VETAIS:" + Символы.ПС
			+ ОписаниеОшибки() + Символы.ПС + Символы.ПС
			+ "Проверьте:" + Символы.ПС
			+ "1) psqlODBC: https://www.postgresql.org/ftp/odbc/versions/msi/" + Символы.ПС
			+ "2) Доступность сервера " + Хост + ":" + Порт + Символы.ПС
			+ "3) Логин/пароль";
	КонецПопытки;
	Возврат Рез;
КонецФункции

// ── Вспомогательная: строка подключения ODBC ─────────────────────
&НаСервереБезКонтекста
Функция СтрокаПодключения(Хост, Порт, База, Польз, Пароль)
	Возврат "Driver={PostgreSQL ANSI(x64)};"
		+ "Server=" + Хост + ";Port=" + Порт + ";Database=" + База + ";"
		+ "Uid=" + Польз + ";Pwd=" + Пароль + ";"
		+ "UseServerSidePrepare=0;Sslmode=disable;";
КонецФункции

#КонецОбласти

#Область СозданиеДокумента1С

&НаСервереБезКонтекста
Функция СоздатьДокументНаСервере(
	Хост, Порт, База, Польз, Пароль,
	ФилиалИД, ИДБезналОплаты,
	ДатаОт, ДатаДо,
	Организация, Склад,
	Номенклатура, СтавкаНДС, ВидОплатыБезнал)

	Рез = Новый Структура("Успех,Сообщение,ДокументСсылка", Ложь, "", Неопределено);

	// 1. Получить чеки
	Данные = ПолучитьЧекиИзVetais(
		Хост, Порт, База, Польз, Пароль,
		ФилиалИД, ИДБезналОплаты, ДатаОт, ДатаДо);

	Если Не Данные.Успех Тогда
		Рез.Сообщение = Данные.Ошибка; Возврат Рез;
	КонецЕсли;
	Если Данные.Чеки.Количество() = 0 Тогда
		Рез.Сообщение = "Нет чеков за выбранный период и филиал"; Возврат Рез;
	КонецЕсли;

	ДатОт = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатДо = Формат(ДатаДо, "ДФ=yyyy-MM-dd");
	ФилиалСтр = ?(ПустаяСтрока(ФилиалИД), "все филиалы", "филиал #" + ФилиалИД);

	Попытка
		Д = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
		Д.Дата        = ДатаДо;
		Д.Организация = Организация;
		Если ЗначениеЗаполнено(Склад) Тогда Д.Склад = Склад; КонецЕсли;
		Д.Комментарий = "Vetais (" + ФилиалСтр + "): " + ДатОт + " — " + ДатДо;

		СуммаНаличных  = 0;
		СуммаБезнала   = 0;
		КолВоЧеков     = Данные.Чеки.Количество();

		// 2. Заполнить табличную часть "Товары" — одна строка на чек
		Для Каждого Чек Из Данные.Чеки Цикл
			Стр = Д.Товары.Добавить();
			Стр.Номенклатура = Номенклатура;  // "Ветеринарные услуги"
			Стр.Количество   = 1;
			Стр.Цена         = Чек.Сумма;
			Стр.Сумма        = Чек.Сумма;
			Стр.СтавкаНДС    = СтавкаНДС;
			Стр.СуммаНДС     = 0;

			Если Чек.ЭтоБезнал Тогда
				СуммаБезнала = СуммаБезнала + Чек.Сумма;
			Иначе
				СуммаНаличных = СуммаНаличных + Чек.Сумма;
			КонецЕсли;
		КонецЦикла;

		// 3. Заполнить вкладку безналичных оплат (если есть)
		Если СуммаБезнала > 0 И ЗначениеЗаполнено(ВидОплатыБезнал) Тогда
			Попытка
				СтрБезнал = Д.ОплатаПлатежнымиКартами.Добавить();
				СтрБезнал.ВидОплаты = ВидОплатыБезнал;
				СтрБезнал.Сумма     = СуммаБезнала;
			Исключение
				// Имя табличной части может отличаться в конфигурации
			КонецПопытки;
		КонецЕсли;

		Д.Записать(РежимЗаписиДокумента.Запись);

		Рез.Успех          = Истина;
		Рез.ДокументСсылка = Д.Ссылка;
		Рез.Сообщение      =
			"Документ создан!" + Символы.ПС +
			"Филиал:    " + ФилиалСтр + Символы.ПС +
			"Период:    " + ДатОт + " — " + ДатДо + Символы.ПС +
			"Чеков:     " + КолВоЧеков + " строк" + Символы.ПС +
			"Наличные:  " + СуммаНаличных + " руб." + Символы.ПС +
			"Безналичные: " + СуммаБезнала + " руб." + Символы.ПС + Символы.ПС +
			"Проверьте документ и проведите вручную.";
	Исключение
		Рез.Сообщение = "ОШИБКА СОЗДАНИЯ ДОКУМЕНТА В 1С:" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
	Возврат Рез;

КонецФункции

#КонецОбласти
