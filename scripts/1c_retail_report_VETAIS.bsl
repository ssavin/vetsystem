// =====================================================================
// ВНЕШНЯЯ ОБРАБОТКА 1С: Отчёт о розничных продажах из Vetais
// Подключение и период запоминаются автоматически после первого запуска
// =====================================================================
//
// КАК СОЗДАТЬ В КОНФИГУРАТОРЕ:
// 1. Файл → Новый → Внешняя обработка
// 2. Добавить форму (Формы → Добавить → Основная: ДА)
//
// 3. Реквизиты формы:
//    Имя                    Тип                              Длина
//    ─────────────────────────────────────────────────────────────
//    ПодкХост               Строка                           100
//    ПодкПорт               Строка                           10
//    ПодкБаза               Строка                           100
//    ПодкПользователь       Строка                           50
//    ПодкПароль             Строка                           50
//    ДатаС                  Дата
//    ДатаПо                 Дата
//    Организация            СправочникСсылка.Организации
//    Склад                  СправочникСсылка.Склады
//    НоменклатураУслуги     СправочникСсылка.Номенклатура
//    НоменклатураТовары     СправочникСсылка.Номенклатура
//    СтавкаНДС              ПеречислениеСсылка.СтавкиНДС
//    РезультатОтчета        Строка(500)
//
// 4. Элементы формы:
//    Группа "Подключение к базе" (разворачиваемая)
//      [Поле ввода]  ПодкХост             "Хост"
//      [Поле ввода]  ПодкПорт             "Порт"
//      [Поле ввода]  ПодкБаза             "База данных"
//      [Поле ввода]  ПодкПользователь     "Пользователь"
//      [Поле ввода]  ПодкПароль           "Пароль" (Режим пароля: Да)
//    Группа "Параметры документа"
//      [Поле даты]   ДатаС                "Период с"
//      [Поле даты]   ДатаПо               "по"
//      [Поле выбора] Организация          "Организация"
//      [Поле выбора] Склад                "Склад"
//      [Поле выбора] НоменклатураУслуги   "Номенклатура: услуги"
//      [Поле выбора] НоменклатураТовары   "Номенклатура: товары"
//      [Поле выбора] СтавкаНДС            "Ставка НДС"
//    [Кнопка]  команда СформироватьОтчет  "Создать документ в 1С"
//    [Поле текста многострочное] РезультатОтчета  "Результат" (ТолькоПросмотр)
//
// ПРИМЕЧАНИЕ: Требуется psqlODBC драйвер на компьютере с 1С
//   Скачать: https://www.postgresql.org/ftp/odbc/versions/msi/
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Период по умолчанию — прошлый месяц
	ДатаС  = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ДатаПо = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	// Первая организация в базе 1С
	Выборка = Справочники.Организации.Выбрать();
	Если Выборка.Следующий() Тогда
		Организация = Выборка.Ссылка;
	КонецЕсли;
	// Загрузить сохранённые настройки поверх умолчаний
	ЗагрузитьНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если ПустаяСтрока(ПодкХост) Или ПустаяСтрока(ПодкБаза) Тогда
		Сообщить("Заполните данные подключения к базе!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаС) Или Не ЗначениеЗаполнено(ДатаПо) Тогда
		Сообщить("Укажите период!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Укажите организацию!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НоменклатураУслуги)
		И Не ЗначениеЗаполнено(НоменклатураТовары) Тогда
		Сообщить("Укажите номенклатуру для услуг и/или товаров!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	РезультатОтчета = "Выполняется запрос к базе...";

	Результат = СоздатьДокумент(
		ПодкХост, ПодкПорт, ПодкБаза, ПодкПользователь, ПодкПароль,
		ДатаС, КонецДня(ДатаПо),
		Организация, Склад,
		НоменклатураУслуги, НоменклатураТовары, СтавкаНДС);

	РезультатОтчета = Результат.Сообщение;

	Если Результат.Успех Тогда
		СохранитьНастройки();
		ПоказатьЗначение(, Результат.ДокументСсылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область НастройкиХранилища

&НаСервере
Процедура ЗагрузитьНастройки()
	Попытка
		Сохр = ХранилищеОбщихНастроек.Загрузить("VetaisRetailReport", "Настройки");
		Если ТипЗнч(Сохр) <> Тип("Структура") Тогда Возврат; КонецЕсли;

		Если Сохр.Свойство("ПодкХост")           Тогда ПодкХост           = Сохр.ПодкХост;           КонецЕсли;
		Если Сохр.Свойство("ПодкПорт")           Тогда ПодкПорт           = Сохр.ПодкПорт;           КонецЕсли;
		Если Сохр.Свойство("ПодкБаза")           Тогда ПодкБаза           = Сохр.ПодкБаза;           КонецЕсли;
		Если Сохр.Свойство("ПодкПользователь")   Тогда ПодкПользователь   = Сохр.ПодкПользователь;   КонецЕсли;
		Если Сохр.Свойство("ПодкПароль")         Тогда ПодкПароль         = Сохр.ПодкПароль;         КонецЕсли;
		Если Сохр.Свойство("ДатаС")              Тогда ДатаС              = Сохр.ДатаС;              КонецЕсли;
		Если Сохр.Свойство("ДатаПо")             Тогда ДатаПо             = Сохр.ДатаПо;             КонецЕсли;
		Если Сохр.Свойство("Организация")        Тогда Организация        = Сохр.Организация;        КонецЕсли;
		Если Сохр.Свойство("Склад")              Тогда Склад              = Сохр.Склад;              КонецЕсли;
		Если Сохр.Свойство("НоменклатураУслуги") Тогда НоменклатураУслуги = Сохр.НоменклатураУслуги; КонецЕсли;
		Если Сохр.Свойство("НоменклатураТовары") Тогда НоменклатураТовары = Сохр.НоменклатураТовары; КонецЕсли;
		Если Сохр.Свойство("СтавкаНДС")          Тогда СтавкаНДС          = Сохр.СтавкаНДС;          КонецЕсли;
	Исключение
		// Первый запуск — настроек нет, работаем с умолчаниями
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	Н = Новый Структура;
	Н.Вставить("ПодкХост",           ПодкХост);
	Н.Вставить("ПодкПорт",           ПодкПорт);
	Н.Вставить("ПодкБаза",           ПодкБаза);
	Н.Вставить("ПодкПользователь",   ПодкПользователь);
	Н.Вставить("ПодкПароль",         ПодкПароль);
	Н.Вставить("ДатаС",              ДатаС);
	Н.Вставить("ДатаПо",             ДатаПо);
	Н.Вставить("Организация",        Организация);
	Н.Вставить("Склад",              Склад);
	Н.Вставить("НоменклатураУслуги", НоменклатураУслуги);
	Н.Вставить("НоменклатураТовары", НоменклатураТовары);
	Н.Вставить("СтавкаНДС",         СтавкаНДС);
	ХранилищеОбщихНастроек.Сохранить("VetaisRetailReport", "Настройки", Н);
КонецПроцедуры

#КонецОбласти

#Область РаботаСБазойИДокументом

&НаСервереБезКонтекста
Функция ПолучитьДанныеВетаис(Хост, Порт, База, Польз, Пароль, ДатаОт, ДатаДо)

	СтрокаПодкл = "Driver={PostgreSQL ANSI(x64)};"
		+ "Server=" + Хост + ";Port=" + Порт + ";Database=" + База + ";"
		+ "Uid=" + Польз + ";Pwd=" + Пароль + ";"
		+ "UseServerSidePrepare=0;Sslmode=disable;";

	ДатОт = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатДо = Формат(ДатаДо, "ДФ=yyyy-MM-dd");

	SQL =
		"WITH t AS ("
		+ " SELECT sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 1) AS tov,"
		+ "        sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 2) AS usl,"
		+ "        sum(ai.sum_with_vat) AS ito"
		+ " FROM accounts_items ai"
		+ " JOIN accounts_headers ah ON ah.id = ai.account_header_id"
		+ " LEFT JOIN items_type it ON it.id = ai.item_type_id"
		+ " WHERE ai.deleted = 0 AND ah.deleted = 0"
		+ "   AND ah.datetime_create::date BETWEEN '" + ДатОт + "' AND '" + ДатДо + "'"
		+ ") SELECT"
		+ "  round(coalesce(ito, 0)::numeric, 2) AS ito,"
		+ "  round(coalesce(usl, 0)::numeric, 2) AS usl,"
		+ "  round(coalesce(tov, 0)::numeric, 2) AS tov"
		+ " FROM t";

	Рез = Новый Структура("Успех,Итого,Услуги,Товары,Ошибка", Ложь, 0, 0, 0, "");
	Попытка
		Conn = Новый COMОбъект("ADODB.Connection");
		Conn.ConnectionString = СтрокаПодкл;
		Conn.CursorLocation   = 3;
		Conn.Open();

		Cmd = Новый COMОбъект("ADODB.Command");
		Cmd.ActiveConnection  = Conn;
		Cmd.CommandText       = SQL;
		Cmd.CommandTimeout    = 60;

		Rs = Cmd.Execute();
		Если Не Rs.EOF Тогда
			Рез.Итого  = Rs.Fields.Item("ito").Value;
			Рез.Услуги = Rs.Fields.Item("usl").Value;
			Рез.Товары = Rs.Fields.Item("tov").Value;
			Рез.Успех  = Истина;
		КонецЕсли;
		Rs.Close();
		Conn.Close();
	Исключение
		Рез.Ошибка =
			"ОШИБКА ПОДКЛЮЧЕНИЯ:" + Символы.ПС + ОписаниеОшибки()
			+ Символы.ПС + Символы.ПС
			+ "Проверьте:" + Символы.ПС
			+ "1) Установлен ли psqlODBC: https://www.postgresql.org/ftp/odbc/versions/msi/" + Символы.ПС
			+ "2) Доступен ли сервер " + Хост + ":" + Порт + " с этого компьютера" + Символы.ПС
			+ "3) Правильность логина и пароля";
	КонецПопытки;
	Возврат Рез;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьДокумент(Хост, Порт, База, Польз, Пароль,
	ДатаОт, ДатаДо, Организация, Склад,
	НоменклатураУслуги, НоменклатураТовары, СтавкаНДС)

	Рез = Новый Структура("Успех,Сообщение,ДокументСсылка", Ложь, "", Неопределено);

	Данные = ПолучитьДанныеВетаис(Хост, Порт, База, Польз, Пароль, ДатаОт, ДатаДо);
	Если Не Данные.Успех Тогда
		Рез.Сообщение = Данные.Ошибка;
		Возврат Рез;
	КонецЕсли;
	Если Данные.Итого = 0 Тогда
		Рез.Сообщение = "Нет данных за выбранный период";
		Возврат Рез;
	КонецЕсли;

	ДатОт = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатДо = Формат(ДатаДо, "ДФ=yyyy-MM-dd");

	Попытка
		Д = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
		Д.Дата        = ДатаДо;
		Д.Организация = Организация;
		Если ЗначениеЗаполнено(Склад) Тогда
			Д.Склад = Склад;
		КонецЕсли;
		Д.Комментарий = "Vetais: " + ДатОт + " — " + ДатДо + " | итого: " + Данные.Итого;

		Если ЗначениеЗаполнено(НоменклатураУслуги) И Данные.Услуги > 0 Тогда
			Стр = Д.Товары.Добавить();
			Стр.Номенклатура = НоменклатураУслуги;
			Стр.Количество   = 1;
			Стр.Цена         = Данные.Услуги;
			Стр.Сумма        = Данные.Услуги;
			Стр.СтавкаНДС    = СтавкаНДС;
			Стр.СуммаНДС     = 0;
		КонецЕсли;

		Если ЗначениеЗаполнено(НоменклатураТовары) И Данные.Товары > 0 Тогда
			Стр = Д.Товары.Добавить();
			Стр.Номенклатура = НоменклатураТовары;
			Стр.Количество   = 1;
			Стр.Цена         = Данные.Товары;
			Стр.Сумма        = Данные.Товары;
			Стр.СтавкаНДС    = СтавкаНДС;
			Стр.СуммаНДС     = 0;
		КонецЕсли;

		Д.Записать(РежимЗаписиДокумента.Запись);

		Рез.Успех          = Истина;
		Рез.ДокументСсылка = Д.Ссылка;
		Рез.Сообщение      =
			"Документ создан!" + Символы.ПС +
			"Период:  " + ДатОт + " — " + ДатДо + Символы.ПС +
			"Итого:   " + Данные.Итого  + " руб." + Символы.ПС +
			"Услуги:  " + Данные.Услуги + " руб." + Символы.ПС +
			"Товары:  " + Данные.Товары + " руб." + Символы.ПС + Символы.ПС +
			"Настройки сохранены — при следующем открытии заполнятся автоматически." + Символы.ПС +
			"Проверьте документ и проведите его вручную.";
	Исключение
		Рез.Сообщение =
			"ОШИБКА СОЗДАНИЯ ДОКУМЕНТА В 1С:" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
	Возврат Рез;

КонецФункции

#КонецОбласти
