// =====================================================================
// ВНЕШНЯЯ ОБРАБОТКА 1С: Отчёт о розничных продажах из Vetais
// v3.0 — выбор филиала из списка, настройки сохраняются между сеансами
// =====================================================================
//
// КАК СОЗДАТЬ В КОНФИГУРАТОРЕ:
// 1. Файл → Новый → Внешняя обработка
// 2. Добавить форму (Формы → Добавить → Основная: ДА)
//
// 3. Реквизиты формы:
//    Имя                    Тип                              Длина
//    ─────────────────────────────────────────────────────────────
//    ПодкХост               Строка                           100
//    ПодкПорт               Строка                           10
//    ПодкБаза               Строка                           100
//    ПодкПользователь       Строка                           50
//    ПодкПароль             Строка                           50
//    ВыбранныйФилиалИД      Строка                           50   ← ID филиала в Vetais
//    ВыбранныйФилиал        Строка                           200  ← Название для отображения
//    ДатаС                  Дата
//    ДатаПо                 Дата
//    Организация            СправочникСсылка.Организации
//    Склад                  СправочникСсылка.Склады
//    НоменклатураУслуги     СправочникСсылка.Номенклатура
//    НоменклатураТовары     СправочникСсылка.Номенклатура
//    СтавкаНДС              ПеречислениеСсылка.СтавкиНДС
//    РезультатОтчета        Строка(500)
//
// 4. Элементы формы:
//    ── Группа "Подключение к базе" ─────────────────────────────
//    [Поле ввода]  ПодкХост             "Хост"
//    [Поле ввода]  ПодкПорт             "Порт"
//    [Поле ввода]  ПодкБаза             "База данных"
//    [Поле ввода]  ПодкПользователь     "Пользователь"
//    [Поле ввода]  ПодкПароль           "Пароль" (Режим пароля: Да)
//    [Кнопка]      команда ЗагрузитьФилиалы  "Загрузить филиалы"
//    ── Группа "Фильтр" ──────────────────────────────────────────
//    [Поле выбора] ВыбранныйФилиал      "Филиал"
//      → СписокВыбора заполняется программно через ЗагрузитьФилиалы
//      → Обработчик ПриИзменении: ФилиалПриИзменении
//    [Поле даты]   ДатаС                "Период с"
//    [Поле даты]   ДатаПо               "по"
//    ── Группа "Параметры документа 1С" ──────────────────────────
//    [Поле выбора] Организация          "Организация"
//    [Поле выбора] Склад                "Склад"
//    [Поле выбора] НоменклатураУслуги   "Номенклатура: услуги"
//    [Поле выбора] НоменклатураТовары   "Номенклатура: товары"
//    [Поле выбора] СтавкаНДС            "Ставка НДС"
//    ─────────────────────────────────────────────────────────────
//    [Кнопка]      команда СформироватьОтчет  "Создать документ в 1С"
//    [Поле текста многострочное] РезультатОтчета  "Результат" (ТолькоПросмотр)
//
// ПРИМЕЧАНИЕ: Требуется psqlODBC на компьютере с 1С
//   Скачать: https://www.postgresql.org/ftp/odbc/versions/msi/
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Умолчания
	ДатаС   = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ДатаПо  = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	Выборка = Справочники.Организации.Выбрать();
	Если Выборка.Следующий() Тогда Организация = Выборка.Ссылка; КонецЕсли;
	// Загрузить сохранённые настройки
	ЗагрузитьНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ── Загрузить список филиалов из Vetais ──────────────────────────
&НаКлиенте
Процедура ЗагрузитьФилиалы(Команда)
	Если ПустаяСтрока(ПодкХост) Или ПустаяСтрока(ПодкБаза) Тогда
		Сообщить("Сначала заполните данные подключения!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Филиалы = ПолучитьФилиалыССервера(ПодкХост, ПодкПорт, ПодкБаза, ПодкПользователь, ПодкПароль);

	Если ТипЗнч(Филиалы) = Тип("Строка") Тогда
		// Это сообщение об ошибке
		Сообщить(Филиалы, СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Элементы.ВыбранныйФилиал.СписокВыбора.Очистить();
	Для Каждого Ф Из Филиалы Цикл
		Элементы.ВыбранныйФилиал.СписокВыбора.Добавить(Ф.ИД, Ф.Название);
	КонецЦикла;

	Если Филиалы.Количество() > 0 Тогда
		// "Все филиалы" первым
		Элементы.ВыбранныйФилиал.СписокВыбора.Вставить(0, "", "— Все филиалы —");
		// Восстановить ранее выбранный или выбрать "Все"
		Если ПустаяСтрока(ВыбранныйФилиалИД) Тогда
			ВыбранныйФилиал    = "— Все филиалы —";
			ВыбранныйФилиалИД  = "";
		Иначе
			Для Каждого Эл Из Элементы.ВыбранныйФилиал.СписокВыбора Цикл
				Если Эл.Значение = ВыбранныйФилиалИД Тогда
					ВыбранныйФилиал = Эл.Представление;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Сообщить("Загружено филиалов: " + Филиалы.Количество());
	КонецЕсли;
КонецПроцедуры

// При изменении филиала сохраняем его ID
&НаКлиенте
Процедура ФилиалПриИзменении(Элемент)
	// Найти ID по названию в списке
	Для Каждого Эл Из Элементы.ВыбранныйФилиал.СписокВыбора Цикл
		Если Эл.Представление = ВыбранныйФилиал Тогда
			ВыбранныйФилиалИД = Эл.Значение;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВыбранныйФилиалИД = "";
КонецПроцедуры

// ── Создать документ ──────────────────────────────────────────────
&НаКлиенте
Процедура СформироватьОтчет(Команда)
	Если ПустаяСтрока(ПодкХост) Или ПустаяСтрока(ПодкБаза) Тогда
		Сообщить("Заполните данные подключения!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаС) Или Не ЗначениеЗаполнено(ДатаПо) Тогда
		Сообщить("Укажите период!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Укажите организацию!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НоменклатураУслуги) И Не ЗначениеЗаполнено(НоменклатураТовары) Тогда
		Сообщить("Укажите номенклатуру для услуг и/или товаров!", СтатусСообщения.Важное); Возврат;
	КонецЕсли;

	РезультатОтчета = "Выполняется запрос к базе...";

	Результат = СоздатьДокумент(
		ПодкХост, ПодкПорт, ПодкБаза, ПодкПользователь, ПодкПароль,
		ВыбранныйФилиалИД,
		ДатаС, КонецДня(ДатаПо),
		Организация, Склад,
		НоменклатураУслуги, НоменклатураТовары, СтавкаНДС);

	РезультатОтчета = Результат.Сообщение;

	Если Результат.Успех Тогда
		СохранитьНастройки();
		ПоказатьЗначение(, Результат.ДокументСсылка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область НастройкиХранилища

&НаСервере
Процедура ЗагрузитьНастройки()
	Попытка
		Сохр = ХранилищеОбщихНастроек.Загрузить("VetaisRetailReport", "Настройки");
		Если ТипЗнч(Сохр) <> Тип("Структура") Тогда Возврат; КонецЕсли;
		Если Сохр.Свойство("ПодкХост")           Тогда ПодкХост           = Сохр.ПодкХост;           КонецЕсли;
		Если Сохр.Свойство("ПодкПорт")           Тогда ПодкПорт           = Сохр.ПодкПорт;           КонецЕсли;
		Если Сохр.Свойство("ПодкБаза")           Тогда ПодкБаза           = Сохр.ПодкБаза;           КонецЕсли;
		Если Сохр.Свойство("ПодкПользователь")   Тогда ПодкПользователь   = Сохр.ПодкПользователь;   КонецЕсли;
		Если Сохр.Свойство("ПодкПароль")         Тогда ПодкПароль         = Сохр.ПодкПароль;         КонецЕсли;
		Если Сохр.Свойство("ВыбранныйФилиалИД")  Тогда ВыбранныйФилиалИД  = Сохр.ВыбранныйФилиалИД;  КонецЕсли;
		Если Сохр.Свойство("ВыбранныйФилиал")    Тогда ВыбранныйФилиал    = Сохр.ВыбранныйФилиал;    КонецЕсли;
		Если Сохр.Свойство("ДатаС")              Тогда ДатаС              = Сохр.ДатаС;              КонецЕсли;
		Если Сохр.Свойство("ДатаПо")             Тогда ДатаПо             = Сохр.ДатаПо;             КонецЕсли;
		Если Сохр.Свойство("Организация")        Тогда Организация        = Сохр.Организация;        КонецЕсли;
		Если Сохр.Свойство("Склад")              Тогда Склад              = Сохр.Склад;              КонецЕсли;
		Если Сохр.Свойство("НоменклатураУслуги") Тогда НоменклатураУслуги = Сохр.НоменклатураУслуги; КонецЕсли;
		Если Сохр.Свойство("НоменклатураТовары") Тогда НоменклатураТовары = Сохр.НоменклатураТовары; КонецЕсли;
		Если Сохр.Свойство("СтавкаНДС")          Тогда СтавкаНДС          = Сохр.СтавкаНДС;          КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	Н = Новый Структура;
	Н.Вставить("ПодкХост",           ПодкХост);
	Н.Вставить("ПодкПорт",           ПодкПорт);
	Н.Вставить("ПодкБаза",           ПодкБаза);
	Н.Вставить("ПодкПользователь",   ПодкПользователь);
	Н.Вставить("ПодкПароль",         ПодкПароль);
	Н.Вставить("ВыбранныйФилиалИД",  ВыбранныйФилиалИД);
	Н.Вставить("ВыбранныйФилиал",    ВыбранныйФилиал);
	Н.Вставить("ДатаС",              ДатаС);
	Н.Вставить("ДатаПо",             ДатаПо);
	Н.Вставить("Организация",        Организация);
	Н.Вставить("Склад",              Склад);
	Н.Вставить("НоменклатураУслуги", НоменклатураУслуги);
	Н.Вставить("НоменклатураТовары", НоменклатураТовары);
	Н.Вставить("СтавкаНДС",         СтавкаНДС);
	ХранилищеОбщихНастроек.Сохранить("VetaisRetailReport", "Настройки", Н);
КонецПроцедуры

#КонецОбласти

#Область РаботаСБазойVetais

// ── Получить список филиалов из Vetais ───────────────────────────
&НаСервереБезКонтекста
Функция ПолучитьФилиалыССервера(Хост, Порт, База, Польз, Пароль)

	СтрокаПодкл = "Driver={PostgreSQL ANSI(x64)};"
		+ "Server=" + Хост + ";Port=" + Порт + ";Database=" + База + ";"
		+ "Uid=" + Польз + ";Pwd=" + Пароль + ";"
		+ "UseServerSidePrepare=0;Sslmode=disable;";

	// Берём только те клиники, по которым есть счета (не пустые)
	SQL = "SELECT c.id::text AS id, c.name"
		+ " FROM clinic c"
		+ " WHERE EXISTS ("
		+ "   SELECT 1 FROM accounts_headers ah"
		+ "   WHERE ah.clinic_id = c.id AND ah.deleted = 0"
		+ " )"
		+ " ORDER BY c.name";

	Попытка
		Conn = Новый COMОбъект("ADODB.Connection");
		Conn.ConnectionString = СтрокаПодкл;
		Conn.CursorLocation   = 3;
		Conn.Open();

		Cmd = Новый COMОбъект("ADODB.Command");
		Cmd.ActiveConnection  = Conn;
		Cmd.CommandText       = SQL;
		Cmd.CommandTimeout    = 30;

		Rs = Cmd.Execute();
		Результат = Новый Массив;
		Пока Не Rs.EOF Цикл
			Стр = Новый Структура("ИД, Название");
			Стр.ИД       = Rs.Fields.Item("id").Value;
			Стр.Название = Rs.Fields.Item("name").Value;
			Результат.Добавить(Стр);
			Rs.MoveNext();
		КонецЦикла;
		Rs.Close();
		Conn.Close();
		Возврат Результат;

	Исключение
		Возврат "ОШИБКА ПОДКЛЮЧЕНИЯ:" + Символы.ПС + ОписаниеОшибки()
			+ Символы.ПС + "Проверьте psqlODBC: https://www.postgresql.org/ftp/odbc/versions/msi/";
	КонецПопытки;

КонецФункции

// ── Получить суммы продаж с фильтром по филиалу ──────────────────
&НаСервереБезКонтекста
Функция ПолучитьДанныеВетаис(Хост, Порт, База, Польз, Пароль, ФилиалИД, ДатаОт, ДатаДо)

	СтрокаПодкл = "Driver={PostgreSQL ANSI(x64)};"
		+ "Server=" + Хост + ";Port=" + Порт + ";Database=" + База + ";"
		+ "Uid=" + Польз + ";Pwd=" + Пароль + ";"
		+ "UseServerSidePrepare=0;Sslmode=disable;";

	ДатОт = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатДо = Формат(ДатаДо, "ДФ=yyyy-MM-dd");

	// Фильтр по филиалу — если выбрано "Все", условие не добавляем
	УслФилиал = "";
	Если Не ПустаяСтрока(ФилиалИД) Тогда
		УслФилиал = " AND ah.clinic_id = " + ФилиалИД;
	КонецЕсли;

	SQL =
		"WITH t AS ("
		+ " SELECT sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 1) AS tov,"
		+ "        sum(ai.sum_with_vat) FILTER (WHERE it.id_type = 2) AS usl,"
		+ "        sum(ai.sum_with_vat) AS ito"
		+ " FROM accounts_items ai"
		+ " JOIN accounts_headers ah ON ah.id = ai.account_header_id"
		+ " LEFT JOIN items_type it ON it.id = ai.item_type_id"
		+ " WHERE ai.deleted = 0 AND ah.deleted = 0"
		+ "   AND ah.datetime_create::date BETWEEN '" + ДатОт + "' AND '" + ДатДо + "'"
		+ УслФилиал
		+ ") SELECT"
		+ "  round(coalesce(ito, 0)::numeric, 2) AS ito,"
		+ "  round(coalesce(usl, 0)::numeric, 2) AS usl,"
		+ "  round(coalesce(tov, 0)::numeric, 2) AS tov"
		+ " FROM t";

	Рез = Новый Структура("Успех,Итого,Услуги,Товары,Ошибка", Ложь, 0, 0, 0, "");
	Попытка
		Conn = Новый COMОбъект("ADODB.Connection");
		Conn.ConnectionString = СтрокаПодкл;
		Conn.CursorLocation   = 3;
		Conn.Open();
		Cmd = Новый COMОбъект("ADODB.Command");
		Cmd.ActiveConnection  = Conn;
		Cmd.CommandText       = SQL;
		Cmd.CommandTimeout    = 60;
		Rs = Cmd.Execute();
		Если Не Rs.EOF Тогда
			Рез.Итого  = Rs.Fields.Item("ito").Value;
			Рез.Услуги = Rs.Fields.Item("usl").Value;
			Рез.Товары = Rs.Fields.Item("tov").Value;
			Рез.Успех  = Истина;
		КонецЕсли;
		Rs.Close(); Conn.Close();
	Исключение
		Рез.Ошибка = "ОШИБКА ПОДКЛЮЧЕНИЯ:" + Символы.ПС + ОписаниеОшибки()
			+ Символы.ПС + Символы.ПС
			+ "Проверьте:" + Символы.ПС
			+ "1) Установлен ли psqlODBC: https://www.postgresql.org/ftp/odbc/versions/msi/" + Символы.ПС
			+ "2) Доступен ли сервер " + Хост + ":" + Порт + Символы.ПС
			+ "3) Правильность логина и пароля";
	КонецПопытки;
	Возврат Рез;

КонецФункции

// ── Создать документ "Отчёт о розничных продажах" в 1С ───────────
&НаСервереБезКонтекста
Функция СоздатьДокумент(Хост, Порт, База, Польз, Пароль,
	ФилиалИД, ДатаОт, ДатаДо,
	Организация, Склад,
	НоменклатураУслуги, НоменклатураТовары, СтавкаНДС)

	Рез = Новый Структура("Успех,Сообщение,ДокументСсылка", Ложь, "", Неопределено);

	Данные = ПолучитьДанныеВетаис(Хост, Порт, База, Польз, Пароль, ФилиалИД, ДатаОт, ДатаДо);
	Если Не Данные.Успех Тогда Рез.Сообщение = Данные.Ошибка; Возврат Рез; КонецЕсли;
	Если Данные.Итого = 0 Тогда Рез.Сообщение = "Нет данных за выбранный период"; Возврат Рез; КонецЕсли;

	ДатОт = Формат(ДатаОт, "ДФ=yyyy-MM-dd");
	ДатДо = Формат(ДатаДо, "ДФ=yyyy-MM-dd");
	ФилиалСтр = ?(ПустаяСтрока(ФилиалИД), "все филиалы", "филиал ID=" + ФилиалИД);

	Попытка
		Д = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
		Д.Дата        = ДатаДо;
		Д.Организация = Организация;
		Если ЗначениеЗаполнено(Склад) Тогда Д.Склад = Склад; КонецЕсли;
		Д.Комментарий = "Vetais (" + ФилиалСтр + "): " + ДатОт + " — " + ДатДо
			+ " | итого: " + Данные.Итого;

		Если ЗначениеЗаполнено(НоменклатураУслуги) И Данные.Услуги > 0 Тогда
			Стр = Д.Товары.Добавить();
			Стр.Номенклатура = НоменклатураУслуги;
			Стр.Количество   = 1;
			Стр.Цена         = Данные.Услуги;
			Стр.Сумма        = Данные.Услуги;
			Стр.СтавкаНДС    = СтавкаНДС;
			Стр.СуммаНДС     = 0;
		КонецЕсли;

		Если ЗначениеЗаполнено(НоменклатураТовары) И Данные.Товары > 0 Тогда
			Стр = Д.Товары.Добавить();
			Стр.Номенклатура = НоменклатураТовары;
			Стр.Количество   = 1;
			Стр.Цена         = Данные.Товары;
			Стр.Сумма        = Данные.Товары;
			Стр.СтавкаНДС    = СтавкаНДС;
			Стр.СуммаНДС     = 0;
		КонецЕсли;

		Д.Записать(РежимЗаписиДокумента.Запись);
		Рез.Успех          = Истина;
		Рез.ДокументСсылка = Д.Ссылка;
		Рез.Сообщение      =
			"Документ создан!" + Символы.ПС +
			"Филиал:  " + ФилиалСтр + Символы.ПС +
			"Период:  " + ДатОт + " — " + ДатДо + Символы.ПС +
			"Итого:   " + Данные.Итого  + " руб." + Символы.ПС +
			"Услуги:  " + Данные.Услуги + " руб." + Символы.ПС +
			"Товары:  " + Данные.Товары + " руб." + Символы.ПС + Символы.ПС +
			"Настройки сохранены. Проверьте и проведите документ вручную.";
	Исключение
		Рез.Сообщение = "ОШИБКА СОЗДАНИЯ ДОКУМЕНТА В 1С:" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
	Возврат Рез;

КонецФункции

#КонецОбласти
