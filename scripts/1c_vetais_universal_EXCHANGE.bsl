// =====================================================================
// ВНЕШНЯЯ ОБРАБОТКА 1С: Универсальный обмен с Vetais
// v2.0 — три режима + защита от дублирования
// =====================================================================
//
// РЕЖИМ 1 «Продажи → 1С»:
//   Читает розничные чеки из Vetais (accounts_headers/items) и создаёт
//   документ «Отчёт о розничных продажах» в 1С (нал/безнал авто).
//   Перед созданием проверяет наличие документа за тот же период.
//
// РЕЖИМ 2 «Приход: 1С/XLS → Vetais»:
//   Создаёт накладную прихода (purchase_headers + purchase_items)
//   в PostgreSQL-базе Vetais из документа 1С «Поступление товаров и услуг»
//   или из XLS-файла поставщика. Перед созданием проверяет номер накладной.
//
// РЕЖИМ 3 «Приходы Vetais → 1С»:
//   Загружает список накладных прихода из Vetais, показывает статус
//   (уже в 1С / не импортирован) и создаёт выбранные как документы
//   «Поступление товаров и услуг» в 1С с сопоставлением номенклатуры.
//
// Требуется: psqlODBC (PostgreSQL Unicode) на компьютере с 1С
//   https://www.postgresql.org/ftp/odbc/versions/msi/
//
// =====================================================================
// СОЗДАНИЕ В КОНФИГУРАТОРЕ:
// 1. Файл → Новый → Внешняя обработка  (имя: VetaisExchange)
// 2. Добавить форму (Основная: ДА)
//
// РЕКВИЗИТЫ ФОРМЫ:
//   ─── Общие ──────────────────────────────────────────────────────────
//   ПодкХост              Строка 100
//   ПодкПорт              Строка 10
//   ПодкБаза              Строка 100
//   ПодкПользователь      Строка 50
//   ПодкПароль            Строка 50
//   ТекущийРежим          Строка 30   ("ПРОДАЖИ" | "ПРИХОД_В" | "ПРИХОД_ИЗ")
//   РезультатОтчета       Строка 2000
//
//   ─── Режим 1: Продажи → 1С ──────────────────────────────────────────
//   Прод_ФилиалИД         Строка 50
//   Прод_Филиал           Строка 200
//   Прод_ДатаС            Дата
//   Прод_ДатаПо           Дата
//   Прод_Организация      СправочникСсылка.Организации
//   Прод_Склад            СправочникСсылка.Склады
//   Прод_Номенклатура     СправочникСсылка.Номенклатура
//   Прод_СтавкаНДС        ПеречислениеСсылка.СтавкиНДС
//   Прод_ВидОплатыБезнал  СправочникСсылка.ВидыОплат
//
//   ─── Режим 2: Приход 1С/XLS → Vetais ────────────────────────────────
//   ПрихВ_ФилиалИД        Строка 50
//   ПрихВ_СкладИД         Строка 50
//   ПрихВ_СубъектИД       Строка 50
//   ПрихВ_ПоставщикИД     Строка 50
//   ПрихВ_Филиал          Строка 200
//   ПрихВ_Склад           Строка 200
//   ПрихВ_Субъект         Строка 200
//   ПрихВ_Поставщик       Строка 200
//   ПрихВ_НомерНакладной  Строка 200
//   ПрихВ_НомерСчета      Строка 200
//   ПрихВ_ДатаНакладной   Дата
//   ПрихВ_РежимИсточника  Строка 10   ("XLS" | "1С")
//   ПрихВ_ПутьКФайлу      Строка 500
//   ПрихВ_СтрЗаголовка    Число
//   ПрихВ_КолНаим         Число
//   ПрихВ_КолШтрих        Число
//   ПрихВ_КолКол          Число
//   ПрихВ_КолЕд           Число
//   ПрихВ_КолЦена         Число
//   ПрихВ_КолНДС          Число
//   ПрихВ_КолСумма        Число
//   ПрихВ_КолСерия        Число
//   ПрихВ_КолСрок         Число
//
//   ─── Режим 3: Приходы Vetais → 1С ───────────────────────────────────
//   ПрихИз_ФилиалИД       Строка 50
//   ПрихИз_Филиал         Строка 200
//   ПрихИз_ДатаС          Дата
//   ПрихИз_ДатаПо         Дата
//   ПрихИз_ПоставщикИД    Строка 50   (фильтр; пусто = все)
//   ПрихИз_Организация    СправочникСсылка.Организации
//   ПрихИз_Склад          СправочникСсылка.Склады
//   ПрихИз_СтавкаНДС      ПеречислениеСсылка.СтавкиНДС
//
// ТАБЛИЧНЫЕ ЧАСТИ ФОРМЫ:
//   ─── ТаблицаСтрок (для режима 2) ────────────────────────────────────
//   НоменклатураНаименование  Строка 300
//   Штрихкод                  Строка 50
//   КодВетаис                 Строка 20   (ручной ввод id из stock_item)
//   НаименованиеВетаис        Строка 300
//   Количество                Число (14,3)
//   ЕдиницаИзмерения          Строка 50
//   ЦенаБезНДС                Число (15,2)
//   СтавкаНДС                 Строка 10
//   СуммаСНДС                 Число (15,2)
//   Серия                     Строка 100
//   СрокГодности              Дата
//   Статус                    Строка 50
//
//   ─── ТаблицаПриходов (для режима 3) ─────────────────────────────────
//   Выбрать                   Булево
//   ВетаисИД                  Строка 20
//   НомерНакладной            Строка 200
//   ДатаНакладной             Дата
//   НазваниеПоставщика        Строка 200
//   Сумма                     Число (15,2)
//   КолСтрок                  Число (10,0)
//   СтатусДубль               Строка 100
//
// ЭЛЕМЕНТЫ ФОРМЫ (структура):
//   [Переключатели ТекущийРежим]:
//      "Продажи → 1С" (ПРОДАЖИ) | "Приход: 1С/XLS → Vetais" (ПРИХОД_В) | "Приходы Vetais → 1С" (ПРИХОД_ИЗ)
//      ПриИзменении: РежимПриИзменении
//
//   [Группа "Подключение к базе Vetais"] — всегда видна
//      ПодкХост, ПодкПорт, ПодкБаза, ПодкПользователь, ПодкПароль
//      [Кнопка] ЗагрузитьСправочники — "Подключиться и загрузить справочники"
//
//   [Группа ГруппаПродажи] — видна при ПРОДАЖИ
//      [Поле выбора] Прод_Филиал  (ПриИзменении: ПродФилиалПриИзменении)
//      [Поле даты]   Прод_ДатаС, Прод_ДатаПо
//      [Поле выбора] Прод_Организация, Прод_Склад, Прод_Номенклатура
//      [Поле выбора] Прод_СтавкаНДС, Прод_ВидОплатыБезнал
//      [Кнопка]      СформироватьПродажи — "Создать Отчёт о продажах в 1С"
//
//   [Группа ГруппаПриходВ] — видна при ПРИХОД_В
//      [Поле выбора] ПрихВ_Филиал, ПрихВ_Склад, ПрихВ_Субъект, ПрихВ_Поставщик
//      [Поле ввода]  ПрихВ_НомерНакладной, ПрихВ_НомерСчета
//      [Поле даты]   ПрихВ_ДатаНакладной
//      [Переключатель] ПрихВ_РежимИсточника = "XLS" | "1С"
//        [Поле ввода] ПрихВ_ПутьКФайлу + [Кнопка] ВыбратьФайл (при XLS)
//        [Группа колонок XLS]: ПрихВ_СтрЗаголовка, КолНаим, КолШтрих, КолКол,
//                               КолЕд, КолЦена, КолНДС, КолСумма, КолСерия, КолСрок
//      [Таблица] ТаблицаСтрок
//      [Кнопки]: ЗагрузитьСтроки | СопоставитьНоменклатуру | СоздатьВVetais
//
//   [Группа ГруппаПриходИз] — видна при ПРИХОД_ИЗ
//      [Поле выбора] ПрихИз_Филиал
//      [Поле даты]   ПрихИз_ДатаС, ПрихИз_ДатаПо
//      [Поле выбора] ПрихИз_ПоставщикИД (фильтр)
//      [Поле выбора] ПрихИз_Организация, ПрихИз_Склад, ПрихИз_СтавкаНДС
//      [Таблица]     ТаблицаПриходов
//      [Кнопки]:     ЗагрузитьПриходыВетаис | СоздатьВыбранныеВ1С
//
//   [Поле текста многострочное] РезультатОтчета (ТолькоПросмотр, высота 5 строк)
// =====================================================================

#Область ОбработчикиСобытийФормы

&НаСоздании
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Дефолты подключения
    ПодкХост           = "109.173.124.18";
    ПодкПорт           = "5454";
    ПодкБаза           = "vetais";
    ПодкПользователь   = "postgres";
    ПодкПароль         = "vetais";

    ТекущийРежим = "ПРОДАЖИ";

    // Режим 1 — дефолты
    Прод_ДатаС    = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
    Прод_ДатаПо   = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
    Прод_СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
    Выборка = Справочники.Организации.Выбрать();
    Если Выборка.Следующий() Тогда
        Прод_Организация = Выборка.Ссылка;
    КонецЕсли;

    // Режим 2 — дефолты
    ПрихВ_ДатаНакладной     = ТекущаяДата();
    ПрихВ_РежимИсточника    = "XLS";
    ПрихВ_СтрЗаголовка      = 1;
    ПрихВ_КолНаим  = 1; ПрихВ_КолШтрих = 2; ПрихВ_КолКол  = 3;
    ПрихВ_КолЕд    = 4; ПрихВ_КолЦена  = 5; ПрихВ_КолНДС  = 6;
    ПрихВ_КолСумма = 7; ПрихВ_КолСерия = 8; ПрихВ_КолСрок = 9;

    // Режим 3 — дефолты
    ПрихИз_ДатаС  = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
    ПрихИз_ДатаПо = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));

    ЗагрузитьНастройки();
    ОбновитьВидимостьГрупп();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РежимПриИзменении(Элемент)
    ОбновитьВидимостьГруппНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочники(Команда)
    РезультатОтчета = "Загрузка справочников...";
    ЗагрузитьСправочникиНаСервере();
КонецПроцедуры

// ─────────────── РЕЖИМ 1: Продажи → 1С ──────────────────────────────

&НаКлиенте
Процедура ПродФилиалПриИзменении(Элемент)
    Для Каждого Эл Из Элементы.Прод_Филиал.СписокВыбора Цикл
        Если Эл.Представление = Прод_Филиал Тогда
            Прод_ФилиалИД = Эл.Значение;
            Возврат;
        КонецЕсли;
    КонецЦикла;
    Прод_ФилиалИД = "";
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПродажи(Команда)
    Если ПустаяСтрока(ПодкХост) Тогда Предупреждение("Заполните подключение!"); Возврат; КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Прод_ДатаС) Тогда Предупреждение("Укажите дату начала периода!"); Возврат; КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Прод_Организация) Тогда Предупреждение("Укажите организацию!"); Возврат; КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Прод_Номенклатура) Тогда Предупреждение("Укажите номенклатуру!"); Возврат; КонецЕсли;
    РезультатОтчета = "Выполняется...";
    Результат = СформироватьПродажиНаСервере();
    РезультатОтчета = Результат.Сообщение;
    Если Результат.Успех И Результат.ДокументСсылка <> Неопределено Тогда
        СохранитьНастройкиНаСервере();
        ПоказатьЗначение(, Результат.ДокументСсылка);
    КонецЕсли;
КонецПроцедуры

// ─────────────── РЕЖИМ 2: Приход 1С/XLS → Vetais ────────────────────

&НаКлиенте
Процедура ПрихВФилиалПриИзменении(Элемент)
    Для Каждого Эл Из Элементы.ПрихВ_Филиал.СписокВыбора Цикл
        Если Эл.Представление = ПрихВ_Филиал Тогда ПрихВ_ФилиалИД = Эл.Значение; Возврат; КонецЕсли;
    КонецЦикла;
    ПрихВ_ФилиалИД = "";
КонецПроцедуры

&НаКлиенте
Процедура ПрихВСкладПриИзменении(Элемент)
    Для Каждого Эл Из Элементы.ПрихВ_Склад.СписокВыбора Цикл
        Если Эл.Представление = ПрихВ_Склад Тогда ПрихВ_СкладИД = Эл.Значение; Возврат; КонецЕсли;
    КонецЦикла;
    ПрихВ_СкладИД = "";
КонецПроцедуры

&НаКлиенте
Процедура ПрихВСубъектПриИзменении(Элемент)
    Для Каждого Эл Из Элементы.ПрихВ_Субъект.СписокВыбора Цикл
        Если Эл.Представление = ПрихВ_Субъект Тогда ПрихВ_СубъектИД = Эл.Значение; Возврат; КонецЕсли;
    КонецЦикла;
    ПрихВ_СубъектИД = "";
КонецПроцедуры

&НаКлиенте
Процедура ПрихВПоставщикПриИзменении(Элемент)
    Для Каждого Эл Из Элементы.ПрихВ_Поставщик.СписокВыбора Цикл
        Если Эл.Представление = ПрихВ_Поставщик Тогда ПрихВ_ПоставщикИД = Эл.Значение; Возврат; КонецЕсли;
    КонецЦикла;
    ПрихВ_ПоставщикИД = "";
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайл(Команда)
    Д = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Д.Фильтр = "Excel (*.xls;*.xlsx)|*.xls;*.xlsx|Все файлы (*.*)|*.*";
    Д.МножественныйВыбор = Ложь;
    Если Д.Выбрать() Тогда ПрихВ_ПутьКФайлу = Д.ПолноеИмяФайла; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтроки(Команда)
    РезультатОтчета = "";
    ТаблицаСтрок.Очистить();
    ЗагрузитьСтрокиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СопоставитьНоменклатуру(Команда)
    РезультатОтчета = "";
    СопоставитьНоменклатуруНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВVetais(Команда)
    Если ПустаяСтрока(ПрихВ_ФилиалИД)       Тогда Предупреждение("Выберите филиал!");          Возврат; КонецЕсли;
    Если ПустаяСтрока(ПрихВ_СкладИД)         Тогда Предупреждение("Выберите склад!");           Возврат; КонецЕсли;
    Если ПустаяСтрока(ПрихВ_НомерНакладной)  Тогда Предупреждение("Введите номер накладной!"); Возврат; КонецЕсли;
    Если ТаблицаСтрок.Количество() = 0       Тогда Предупреждение("Загрузите строки!");        Возврат; КонецЕсли;

    НеСопост = 0;
    Для Каждого С Из ТаблицаСтрок Цикл
        Если ПустаяСтрока(С.КодВетаис) Тогда НеСопост = НеСопост + 1; КонецЕсли;
    КонецЦикла;
    Если НеСопост > 0 Тогда
        Отв = Вопрос("⚠️ " + НеСопост + " строк не сопоставлены — они будут пропущены." + Символы.ПС + "Продолжить?",
                     РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
        Если Отв <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    КонецЕсли;

    РезультатОтчета = "Создание документа в Vetais...";
    СоздатьДокументВVetaisНаСервере();
КонецПроцедуры

// ─────────────── РЕЖИМ 3: Приходы Vetais → 1С ───────────────────────

&НаКлиенте
Процедура ПрихИзФилиалПриИзменении(Элемент)
    Для Каждого Эл Из Элементы.ПрихИз_Филиал.СписокВыбора Цикл
        Если Эл.Представление = ПрихИз_Филиал Тогда ПрихИз_ФилиалИД = Эл.Значение; Возврат; КонецЕсли;
    КонецЦикла;
    ПрихИз_ФилиалИД = "";
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПриходыВетаис(Команда)
    Если ПустаяСтрока(ПодкХост) Тогда Предупреждение("Заполните подключение!"); Возврат; КонецЕсли;
    РезультатОтчета = "Загрузка приходов из Vetais...";
    ТаблицаПриходов.Очистить();
    ЗагрузитьПриходыВетаисНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеПриходы(Команда)
    Для Каждого С Из ТаблицаПриходов Цикл
        Если С.СтатусДубль = "Не импортирован" Тогда С.Выбрать = Истина; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВыбранныеВ1С(Команда)
    Если НЕ ЗначениеЗаполнено(ПрихИз_Организация) Тогда Предупреждение("Укажите организацию 1С!"); Возврат; КонецЕсли;

    КолВыбр = 0;
    Для Каждого С Из ТаблицаПриходов Цикл
        Если С.Выбрать Тогда КолВыбр = КолВыбр + 1; КонецЕсли;
    КонецЦикла;
    Если КолВыбр = 0 Тогда Предупреждение("Отметьте накладные для создания в 1С!"); Возврат; КонецЕсли;

    Отв = Вопрос("Создать " + КолВыбр + " документ(а) «Поступление товаров и услуг» в 1С?",
                 РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
    Если Отв <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;

    РезультатОтчета = "Создание документов в 1С...";
    СоздатьВыбранныеВ1СНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыКлиент

&НаКлиенте
Процедура ОбновитьВидимостьГруппНаКлиенте()
    Элементы.ГруппаПродажи.Видимость   = (ТекущийРежим = "ПРОДАЖИ");
    Элементы.ГруппаПриходВ.Видимость   = (ТекущийРежим = "ПРИХОД_В");
    Элементы.ГруппаПриходИз.Видимость  = (ТекущийРежим = "ПРИХОД_ИЗ");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиНаСервере

&НаСервере
Процедура ОбновитьВидимостьГрупп()
    Элементы.ГруппаПродажи.Видимость   = (ТекущийРежим = "ПРОДАЖИ");
    Элементы.ГруппаПриходВ.Видимость   = (ТекущийРежим = "ПРИХОД_В");
    Элементы.ГруппаПриходИз.Видимость  = (ТекущийРежим = "ПРИХОД_ИЗ");
КонецПроцедуры

// ──────────────────────────────────────────────────────────────────────
// ЗАГРУЗКА СПРАВОЧНИКОВ (общая для всех режимов)
// ──────────────────────────────────────────────────────────────────────
&НаСервере
Процедура ЗагрузитьСправочникиНаСервере()
    Попытка
        Conn = ОткрытьСоединение();

        // ── Филиалы (file_clinics) ──
        РезФ = ВыполнитьSQL(Conn, "SELECT id::text AS id, name FROM file_clinics WHERE del = 0 ORDER BY name");
        ОчиститьСписок(Элементы.Прод_Филиал);
        Элементы.Прод_Филиал.СписокВыбора.Добавить("", "— Все филиалы —");
        ОчиститьСписок(Элементы.ПрихВ_Филиал);
        ОчиститьСписок(Элементы.ПрихИз_Филиал);
        Пока Не РезФ.EOF Цикл
            ИД = Строка(РезФ.Fields.Item("id").Value);
            НМ = Строка(РезФ.Fields.Item("name").Value);
            Элементы.Прод_Филиал.СписокВыбора.Добавить(ИД, НМ);
            Элементы.ПрихВ_Филиал.СписокВыбора.Добавить(ИД, НМ);
            Элементы.ПрихИз_Филиал.СписокВыбора.Добавить(ИД, НМ);
            РезФ.MoveNext();
        КонецЦикла;
        РезФ.Close();

        // ── Склады (eco_stock) ──
        РезС = ВыполнитьSQL(Conn, "SELECT id::text AS id, name FROM eco_stock WHERE deleted IS DISTINCT FROM 1 ORDER BY name");
        ОчиститьСписок(Элементы.ПрихВ_Склад);
        Пока Не РезС.EOF Цикл
            Элементы.ПрихВ_Склад.СписокВыбора.Добавить(
                Строка(РезС.Fields.Item("id").Value),
                Строка(РезС.Fields.Item("name").Value));
            РезС.MoveNext();
        КонецЦикла;
        РезС.Close();

        // ── Субъекты / поставщики (list_subject) ──
        РезП = ВыполнитьSQL(Conn, "SELECT id::text AS id, name FROM list_subject WHERE deleted IS DISTINCT FROM 1 ORDER BY name");
        ОчиститьСписок(Элементы.ПрихВ_Субъект);
        ОчиститьСписок(Элементы.ПрихВ_Поставщик);
        ОчиститьСписок(Элементы.ПрихИз_ПоставщикФильтр);
        Элементы.ПрихИз_ПоставщикФильтр.СписокВыбора.Добавить("", "— Все поставщики —");
        Пока Не РезП.EOF Цикл
            ИД = Строка(РезП.Fields.Item("id").Value);
            НМ = Строка(РезП.Fields.Item("name").Value);
            Элементы.ПрихВ_Субъект.СписокВыбора.Добавить(ИД, НМ);
            Элементы.ПрихВ_Поставщик.СписокВыбора.Добавить(ИД, НМ);
            Элементы.ПрихИз_ПоставщикФильтр.СписокВыбора.Добавить(ИД, НМ);
            РезП.MoveNext();
        КонецЦикла;
        РезП.Close();

        ЗакрытьСоединение(Conn);
        СохранитьНастройкиНаСервере();
        РезультатОтчета = "✅ Справочники загружены. Выберите нужный режим и продолжайте.";
    Исключение
        РезультатОтчета = "❌ Ошибка загрузки справочников: " + Символы.ПС + ОписаниеОшибки()
            + Символы.ПС + "Проверьте параметры подключения и наличие psqlODBC.";
    КонецПопытки;
КонецПроцедуры

// ──────────────────────────────────────────────────────────────────────
// РЕЖИМ 1: Продажи Vetais → 1С
// ──────────────────────────────────────────────────────────────────────
&НаСервере
Функция СформироватьПродажиНаСервере()
    Рез = Новый Структура("Успех,Сообщение,ДокументСсылка", Ложь, "", Неопределено);
    Попытка
        // ── Защита от дублей: проверить существующий документ в 1С ──
        ДатОт  = Формат(Прод_ДатаС, "ДФ=yyyy-MM-dd");
        ДатДо  = Формат(КонецДня(Прод_ДатаПо), "ДФ=yyyy-MM-dd");
        ФилСтр = ?(ПустаяСтрока(Прод_ФилиалИД), "все филиалы", "филиал #" + Прод_ФилиалИД);
        МетаКлюч = "Vetais (" + ФилСтр + "): " + ДатОт + " — " + ДатДо;

        ВыборкаДубль = Документы.ОтчетОРозничныхПродажах.Выбрать(
            НачалоДня(Прод_ДатаС), КонецДня(Прод_ДатаПо));
        Пока ВыборкаДубль.Следующий() Цикл
            Если Найти(ВыборкаДубль.Комментарий, МетаКлюч) > 0 Тогда
                Рез.Сообщение = "⚠️ ДУБЛЬ: документ за этот период уже существует в 1С!" + Символы.ПС
                    + "Документ: " + Строка(ВыборкаДубль.Ссылка) + Символы.ПС
                    + "Если нужно пересоздать — удалите или проведите исходный документ вручную.";
                Рез.ДокументСсылка = ВыборкаДубль.Ссылка;
                Рез.Успех = Ложь;
                Возврат Рез;
            КонецЕсли;
        КонецЦикла;

        // ── Получить чеки из Vetais ──
        Conn = ОткрытьСоединение();
        УслФ = ?(НЕ ПустаяСтрока(Прод_ФилиалИД), " AND ah.clinic_id = " + Прод_ФилиалИД, "");
        SQL = "SELECT ah.id::text AS id,
                round(COALESCE(SUM(ai.sum_with_vat),0)::numeric,2) AS total,
                CASE WHEN lower(COALESCE(pm.name,'')) ~ '(карт|банк|безнал|счёт|эквайр)'
                     THEN 'noncash' ELSE 'cash' END AS pay_cat
               FROM accounts_headers ah
               LEFT JOIN accounts_items ai
                 ON ai.account_header_id = ah.id AND ai.deleted = 0
               LEFT JOIN payment_methods pm ON pm.id = ah.payment_type
               WHERE ah.deleted = 0
                 AND ah.datetime_create::date BETWEEN '" + ДатОт + "' AND '" + ДатДо + "'"
               + УслФ
               + " GROUP BY ah.id, pm.name
                 HAVING COALESCE(SUM(ai.sum_with_vat),0) > 0
                 ORDER BY ah.id";

        РесЧеки = ВыполнитьSQL(Conn, SQL);
        Чеки = Новый Массив;
        Пока Не РесЧеки.EOF Цикл
            Чеки.Добавить(Новый Структура(
                "Сумма,ЭтоБезнал",
                РесЧеки.Fields.Item("total").Value,
                РесЧеки.Fields.Item("pay_cat").Value = "noncash"));
            РесЧеки.MoveNext();
        КонецЦикла;
        РесЧеки.Close();
        ЗакрытьСоединение(Conn);

        Если Чеки.Количество() = 0 Тогда
            Рез.Сообщение = "ℹ️ Нет чеков за выбранный период/филиал."; Возврат Рез;
        КонецЕсли;

        // ── Создать документ в 1С ──
        Д = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
        Д.Дата        = КонецДня(Прод_ДатаПо);
        Д.Организация = Прод_Организация;
        Если ЗначениеЗаполнено(Прод_Склад) Тогда Д.Склад = Прод_Склад; КонецЕсли;
        Д.Комментарий = МетаКлюч;

        СумНал = 0; СумБезнал = 0;
        Для Каждого Чек Из Чеки Цикл
            Стр = Д.Товары.Добавить();
            Стр.Номенклатура = Прод_Номенклатура;
            Стр.Количество   = 1;
            Стр.Цена         = Чек.Сумма;
            Стр.Сумма        = Чек.Сумма;
            Стр.СтавкаНДС    = Прод_СтавкаНДС;
            Стр.СуммаНДС     = 0;
            Если Чек.ЭтоБезнал Тогда СумБезнал = СумБезнал + Чек.Сумма;
            Иначе                    СумНал     = СумНал     + Чек.Сумма;
            КонецЕсли;
        КонецЦикла;

        Если ЗначениеЗаполнено(Прод_ВидОплатыБезнал) И СумБезнал > 0 Тогда
            Бн = Д.ОплатаПлатежнымиКартами.Добавить();
            Бн.ВидОплаты = Прод_ВидОплатыБезнал;
            Бн.Сумма     = СумБезнал;
        КонецЕсли;

        Д.Записать(РежимЗаписиДокумента.Запись);

        Рез.Успех = Истина;
        Рез.ДокументСсылка = Д.Ссылка;
        Рез.Сообщение =
            "✅ ДОКУМЕНТ СОЗДАН В 1С" + Символы.ПС +
            "   Чеков:        " + Чеки.Количество()        + Символы.ПС +
            "   Наличные:     " + Формат(СумНал,    "ЧЦ=15; ЧДЦ=2; ЧРД=.") + " руб." + Символы.ПС +
            "   Безналичные:  " + Формат(СумБезнал, "ЧЦ=15; ЧДЦ=2; ЧРД=.") + " руб." + Символы.ПС +
            "   Итого:        " + Формат(СумНал + СумБезнал, "ЧЦ=15; ЧДЦ=2; ЧРД=.") + " руб.";
    Исключение
        Рез.Сообщение = "❌ Ошибка: " + ОписаниеОшибки();
        Попытка ЗакрытьСоединение(Conn); Исключение КонецПопытки;
    КонецПопытки;
    Возврат Рез;
КонецФункции

// ──────────────────────────────────────────────────────────────────────
// РЕЖИМ 2: Загрузка строк (XLS или 1С документ)
// ──────────────────────────────────────────────────────────────────────
&НаСервере
Процедура ЗагрузитьСтрокиНаСервере()
    Если ПрихВ_РежимИсточника = "XLS" Тогда
        ЗагрузитьСтрокиИзXLS();
    ИначеЕсли ПрихВ_РежимИсточника = "1С" Тогда
        ЗагрузитьСтрокиИз1С();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСтрокиИзXLS()
    Если ПустаяСтрока(ПрихВ_ПутьКФайлу) Тогда РезультатОтчета = "❌ Укажите путь к XLS-файлу"; Возврат; КонецЕсли;
    Попытка
        XL = Новый COMОбъект("Excel.Application");
        XL.Visible = Ложь; XL.DisplayAlerts = Ложь;
        Кн = XL.Workbooks.Open(ПрихВ_ПутьКФайлу);
        Лс = Кн.Sheets(1);
        НачСтр = ПрихВ_СтрЗаголовка + 1;
        КонСтр  = Лс.UsedRange.Rows.Count;
        Кол = 0;
        Для НС = НачСтр По КонСтр Цикл
            НМ = Строка(Лс.Cells(НС, ПрихВ_КолНаим).Value);
            Если ПустаяСтрока(НМ) Тогда Продолжить; КонецЕсли;
            С = ТаблицаСтрок.Добавить();
            С.НоменклатураНаименование = НМ;
            С.Штрихкод       = ?(ПрихВ_КолШтрих > 0, Строка(Лс.Cells(НС, ПрихВ_КолШтрих).Value), "");
            С.Количество     = ?(ПрихВ_КолКол   > 0, Число(Строка(Лс.Cells(НС, ПрихВ_КолКол).Value)), 0);
            С.ЕдиницаИзмерения = ?(ПрихВ_КолЕд  > 0, Строка(Лс.Cells(НС, ПрихВ_КолЕд).Value), "");
            С.ЦенаБезНДС     = ?(ПрихВ_КолЦена  > 0, Число(Строка(Лс.Cells(НС, ПрихВ_КолЦена).Value)), 0);
            С.СтавкаНДС      = ?(ПрихВ_КолНДС   > 0, Строка(Лс.Cells(НС, ПрихВ_КолНДС).Value), "0");
            С.СуммаСНДС      = ?(ПрихВ_КолСумма > 0, Число(Строка(Лс.Cells(НС, ПрихВ_КолСумма).Value)), 0);
            С.Серия          = ?(ПрихВ_КолСерия  > 0, Строка(Лс.Cells(НС, ПрихВ_КолСерия).Value), "");
            Если ПрихВ_КолСрок > 0 Тогда
                ЗнСр = Лс.Cells(НС, ПрихВ_КолСрок).Value;
                Попытка С.СрокГодности = ?(ЗнСр <> Неопределено, Дата(Строка(ЗнСр)), '00010101');
                Исключение С.СрокГодности = '00010101'; КонецПопытки;
            КонецЕсли;
            С.Статус = "Не сопоставлен";
            Кол = Кол + 1;
        КонецЦикла;
        Кн.Close(Ложь); XL.Quit(); XL = Неопределено;
        РезультатОтчета = "✅ Загружено строк из XLS: " + Кол;
    Исключение
        РезультатОтчета = "❌ Ошибка чтения XLS: " + ОписаниеОшибки();
        Попытка Кн.Close(Ложь); XL.Quit(); Исключение КонецПопытки;
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСтрокиИз1С()
    Попытка
        // Ищем последний документ «Поступление товаров и услуг»
        Выб = Документы.ПоступлениеТоваровУслуг.Выбрать(
            ДобавитьМесяц(ТекущаяДата(), -3), ТекущаяДата());
        ДокОбъект = Неопределено;
        Пока Выб.Следующий() Цикл ДокОбъект = Выб.ПолучитьОбъект(); Прервать; КонецЦикла;
        Если ДокОбъект = Неопределено Тогда
            РезультатОтчета = "❌ Нет документов «Поступление товаров и услуг» за последние 3 месяца.";
            Возврат;
        КонецЕсли;
        ПрихВ_НомерНакладной = Строка(ДокОбъект.НомерВходящегоДокумента);
        ПрихВ_ДатаНакладной  = ДокОбъект.Дата;
        Кол = 0;
        Для Каждого СтрТЧ Из ДокОбъект.Товары Цикл
            НМ = Строка(СтрТЧ.Номенклатура.Наименование);
            Если ПустаяСтрока(НМ) Тогда Продолжить; КонецЕсли;
            С = ТаблицаСтрок.Добавить();
            С.НоменклатураНаименование = НМ;
            С.Штрихкод       = Строка(СтрТЧ.Номенклатура.Штрихкод);
            С.Количество     = СтрТЧ.Количество;
            С.ЕдиницаИзмерения = Строка(СтрТЧ.ЕдиницаИзмерения.Наименование);
            С.ЦенаБезНДС     = СтрТЧ.Цена;
            С.СтавкаНДС      = Строка(СтрТЧ.СтавкаНДС);
            С.СуммаСНДС      = СтрТЧ.Сумма;
            С.Серия          = Строка(СтрТЧ.СерияНоменклатуры);
            С.Статус         = "Не сопоставлен";
            Кол = Кол + 1;
        КонецЦикла;
        РезультатОтчета = "✅ Загружено строк из документа 1С: " + Кол
            + " (Вх. номер: " + ПрихВ_НомерНакладной + ")";
    Исключение
        РезультатОтчета = "❌ Ошибка чтения документа 1С: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

// ──────────────────────────────────────────────────────────────────────
// РЕЖИМ 2: Сопоставление номенклатуры
// ──────────────────────────────────────────────────────────────────────
&НаСервере
Процедура СопоставитьНоменклатуруНаСервере()
    Если ТаблицаСтрок.Количество() = 0 Тогда
        РезультатОтчета = "❌ Сначала загрузите строки"; Возврат;
    КонецЕсли;
    Попытка
        Conn = ОткрытьСоединение();
        // Загрузить всю номенклатуру в ТЗ для быстрого поиска
        НомТЗ = Новый ТаблицаЗначений();
        НомТЗ.Колонки.Добавить("id");
        НомТЗ.Колонки.Добавить("name_low");   // нижний регистр для поиска
        НомТЗ.Колонки.Добавить("name_orig");
        НомТЗ.Колонки.Добавить("ean");
        НомТЗ.Колонки.Добавить("id_1c");
        НомТЗ.Колонки.Добавить("unit_purchase_id");
        НомТЗ.Колонки.Добавить("vat_purchase_id");

        РезН = ВыполнитьSQL(Conn, "SELECT id::text, name, ean_code, id_1c, unit_purchase_id::text, vat_purchase_id::text
                                     FROM stock_item WHERE deleted IS DISTINCT FROM 1");
        Пока Не РезН.EOF Цикл
            Н = НомТЗ.Добавить();
            Н.id               = Строка(РезН.Fields.Item("id").Value);
            Н.name_orig        = Строка(РезН.Fields.Item("name").Value);
            Н.name_low         = НРег(Строка(РезН.Fields.Item("name").Value));
            Н.ean              = СокрЛП(Строка(РезН.Fields.Item("ean_code").Value));
            Н.id_1c            = СокрЛП(Строка(РезН.Fields.Item("id_1c").Value));
            Н.unit_purchase_id = Строка(РезН.Fields.Item("unit_purchase_id").Value);
            Н.vat_purchase_id  = Строка(РезН.Fields.Item("vat_purchase_id").Value);
            РезН.MoveNext();
        КонецЦикла;
        РезН.Close();
        ЗакрытьСоединение(Conn);

        НайдКол = 0; НеНайдКол = 0;
        Для Каждого С Из ТаблицаСтрок Цикл
            Если НЕ ПустаяСтрока(С.КодВетаис) Тогда Продолжить; КонецЕсли;
            НайдСтр = Неопределено;

            // 1. По штрихкоду
            Если НЕ ПустаяСтрока(С.Штрихкод) Тогда
                Рез = НомТЗ.НайтиСтроки(Новый Структура("ean", СокрЛП(С.Штрихкод)));
                Если Рез.Количество() > 0 Тогда НайдСтр = Рез[0]; КонецЕсли;
            КонецЕсли;

            // 2. По коду 1С (id_1c хранит код номенклатуры из 1С)
            Если НайдСтр = Неопределено И НЕ ПустаяСтрока(С.Штрихкод) Тогда
                Рез = НомТЗ.НайтиСтроки(Новый Структура("id_1c", СокрЛП(С.Штрихкод)));
                Если Рез.Количество() > 0 Тогда НайдСтр = Рез[0]; КонецЕсли;
            КонецЕсли;

            // 3. По точному совпадению имени
            Если НайдСтр = Неопределено Тогда
                НМН = НРег(СокрЛП(С.НоменклатураНаименование));
                Рез = НомТЗ.НайтиСтроки(Новый Структура("name_low", НМН));
                Если Рез.Количество() > 0 Тогда НайдСтр = Рез[0]; КонецЕсли;
            КонецЕсли;

            // 4. Нечёткий — вхождение первых 25 символов
            Если НайдСтр = Неопределено Тогда
                Часть = Лев(НРег(СокрЛП(С.НоменклатураНаименование)), 25);
                Для Каждого НС Из НомТЗ Цикл
                    Если Найти(НС.name_low, Часть) > 0 Тогда НайдСтр = НС; Прервать; КонецЕсли;
                КонецЦикла;
            КонецЕсли;

            Если НайдСтр <> Неопределено Тогда
                С.КодВетаис          = НайдСтр.id;
                С.НаименованиеВетаис = НайдСтр.name_orig;
                С.Статус             = "✅ Найден";
                НайдКол = НайдКол + 1;
            Иначе
                С.Статус = "❌ НЕ НАЙДЕН";
                НеНайдКол = НеНайдКол + 1;
            КонецЕсли;
        КонецЦикла;

        РезультатОтчета = "✅ Сопоставлено: " + НайдКол + "   ❌ Не найдено: " + НеНайдКол + Символы.ПС +
            "Для незнайденных вручную введите id из stock_item в колонку «КодВетаис».";
    Исключение
        РезультатОтчета = "❌ Ошибка сопоставления: " + ОписаниеОшибки();
        Попытка ЗакрытьСоединение(Conn); Исключение КонецПопытки;
    КонецПопытки;
КонецПроцедуры

// ──────────────────────────────────────────────────────────────────────
// РЕЖИМ 2: Создание накладной прихода в Vetais
// ──────────────────────────────────────────────────────────────────────
&НаСервере
Процедура СоздатьДокументВVetaisНаСервере()
    Попытка
        Conn = ОткрытьСоединение();

        // ── Защита от дублей: проверить по номеру накладной и clinic_id ──
        НомЭкр = Экр(ПрихВ_НомерНакладной);
        СQLПровДубль = "SELECT id FROM purchase_headers WHERE no_number = '" + НомЭкр
            + "' AND clinic_id = " + ПрихВ_ФилиалИД + " AND deleted = 0";
        РесД = ВыполнитьSQL(Conn, СQLПровДубль);
        Если НЕ РесД.EOF Тогда
            СущИД = Строка(РесД.Fields.Item("id").Value);
            РесД.Close();
            ЗакрытьСоединение(Conn);
            РезультатОтчета = "⚠️ ДУБЛЬ: накладная с номером «" + ПрихВ_НомерНакладной
                + "» уже существует в Vetais (id=" + СущИД + ")." + Символы.ПС
                + "Если нужно пересоздать — сначала удалите существующий документ в Vetais.";
            Возврат;
        КонецЕсли;
        РесД.Close();

        // ── Следующий id ──
        НовИД = ПолучитьNextval(Conn, "purchase_headers_id_seq");

        // ── Итого с НДС ──
        ИтогоСНДС = 0;
        Для Каждого С Из ТаблицаСтрок Цикл
            Если НЕ ПустаяСтрока(С.КодВетаис) Тогда ИтогоСНДС = ИтогоСНДС + С.СуммаСНДС; КонецЕсли;
        КонецЦикла;

        ДатSQL      = Формат(ПрихВ_ДатаНакладной, "ДФ=yyyy-MM-dd");
        ИД_Субъ     = ?(ПустаяСтрока(ПрихВ_СубъектИД),  "NULL", ПрихВ_СубъектИД);
        ИД_Пост     = ?(ПустаяСтрока(ПрихВ_ПоставщикИД), "NULL", ПрихВ_ПоставщикИД);

        ВыполнитьSQL(Conn,
            "INSERT INTO purchase_headers (id, id_type, id_state, dt_when, id_subject, id_supplier,
             no_number, no_evidence, sum_price_vat, id_currency, id_stock, deleted, clinic_id,
             dt_created, user_id, show_all_methods, from_sbs) VALUES ("
            + НовИД + ",1,1,'" + ДатSQL + "',"
            + ИД_Субъ + "," + ИД_Пост + ",'"
            + Экр(ПрихВ_НомерНакладной) + "','"
            + Экр(ПрихВ_НомерСчета)     + "',"
            + Формат(ИтогоСНДС, "ЧРД=.; ЧН=0") + ","
            + "1," + ПрихВ_СкладИД + ",0," + ПрихВ_ФилиалИД
            + ",NOW(),0,0,0)");

        ВставлСтр = 0; ПропустСтр = 0; ОшибкаСтр = 0;
        Для Каждого С Из ТаблицаСтрок Цикл
            Если ПустаяСтрока(С.КодВетаис) Тогда ПропустСтр = ПропустСтр + 1; Продолжить; КонецЕсли;
            Попытка
                НовИДС = ПолучитьNextval(Conn, "purchase_items_id_seq");
                // НДС
                ПНДС = СтрЗаменить(СтрЗаменить(Строка(С.СтавкаНДС), "%",""), " ","");
                ПНДС = СтрЗаменить(ПНДС, "БезНДС","0");
                Если ПНДС = "10" Тогда ИД_НДС = "2"; ИмяНДС = "10";
                ИначеЕсли ПНДС = "18" ИЛИ ПНДС = "20" Тогда ИД_НДС = "3"; ИмяНДС = "18";
                Иначе ИД_НДС = "1"; ИмяНДС = "0"; КонецЕсли;
                Кол = ?(С.Количество = 0, 1, С.Количество);
                ЦенаБН = С.ЦенаБезНДС;
                СумСН  = С.СуммаСНДС;
                СумБН  = ?(ЦенаБН > 0, ЦенаБН * Кол, СумСН);
                СумНДС = СумСН - СумБН;
                СрокSQL = ?(С.СрокГодности <> '00010101',
                    "'" + Формат(С.СрокГодности, "ДФ=yyyy-MM-dd") + "'", "NULL");
                ВыполнитьSQL(Conn,
                    "INSERT INTO purchase_items (id, purchase_header_id, id_stock_item,
                     sarze, dt_expiration, amount, price_unit, price, price_vat, price_with_vat,
                     dt_created, deleted, id_stock, clinic_id, purchase_status_id, create_status,
                     vat_purchase_id, vat_purchase_name, unit_purchase_id, unit_purchase_name,
                     unit_sale_id, unit_sale_name, stock_item_name) VALUES ("
                    + НовИДС + "," + НовИД + "," + С.КодВетаис + ",'"
                    + Экр(С.Серия) + "'," + СрокSQL + ","
                    + Формат(Кол,    "ЧРД=.; ЧН=0") + ","
                    + Формат(ЦенаБН, "ЧРД=.; ЧН=0") + ","
                    + Формат(СумБН,  "ЧРД=.; ЧН=0") + ","
                    + Формат(СумНДС, "ЧРД=.; ЧН=0") + ","
                    + Формат(СумСН,  "ЧРД=.; ЧН=0")
                    + ",NOW(),0," + ПрихВ_СкладИД + "," + ПрихВ_ФилиалИД
                    + ",1,1," + ИД_НДС + ",'" + ИмяНДС + "'"
                    + ",3,'" + Экр(С.ЕдиницаИзмерения) + "'"
                    + ",3,'" + Экр(С.ЕдиницаИзмерения) + "'"
                    + ",'" + Экр(С.НоменклатураНаименование) + "')");
                ВставлСтр = ВставлСтр + 1;
            Исключение
                ОшибкаСтр = ОшибкаСтр + 1;
            КонецПопытки;
        КонецЦикла;

        ЗакрытьСоединение(Conn);
        РезультатОтчета =
            "✅ НАКЛАДНАЯ СОЗДАНА В VETAIS (id=" + НовИД + ")" + Символы.ПС +
            "   Номер:          " + ПрихВ_НомерНакладной + Символы.ПС +
            "   Строк вставлено:" + ВставлСтр + Символы.ПС +
            "   Строк пропущено:" + ПропустСтр + Символы.ПС +
            "   Строк ошибок:   " + ОшибкаСтр  + Символы.ПС + Символы.ПС +
            "⚠️  Войдите в Vetais → Склад → Приходы и проведите документ id=" + НовИД
            + " для зачисления товаров на остатки.";
    Исключение
        РезультатОтчета = "❌ Ошибка создания в Vetais: " + ОписаниеОшибки();
        Попытка ЗакрытьСоединение(Conn); Исключение КонецПопытки;
    КонецПопытки;
КонецПроцедуры

// ──────────────────────────────────────────────────────────────────────
// РЕЖИМ 3: Загрузка приходов из Vetais с проверкой дублей в 1С
// ──────────────────────────────────────────────────────────────────────
&НаСервере
Процедура ЗагрузитьПриходыВетаисНаСервере()
    Попытка
        Conn = ОткрытьСоединение();
        ДатОт = Формат(ПрихИз_ДатаС,  "ДФ=yyyy-MM-dd");
        ДатДо = Формат(КонецДня(ПрихИз_ДатаПо), "ДФ=yyyy-MM-dd");
        УслФ  = ?(НЕ ПустаяСтрока(ПрихИз_ФилиалИД),     " AND ph.clinic_id = " + ПрихИз_ФилиалИД, "");
        УслП  = ?(НЕ ПустаяСтрока(ПрихИз_ПоставщикИД),  " AND ph.id_supplier = " + ПрихИз_ПоставщикИД, "");

        SQL = "SELECT ph.id::text AS id,
                      ph.no_number,
                      ph.dt_when,
                      COALESCE(ls.name,'') AS supplier_name,
                      COALESCE(ph.sum_price_vat, 0) AS total,
                      COUNT(pi.id) AS cnt_items
               FROM purchase_headers ph
               LEFT JOIN list_subject ls ON ls.id = ph.id_supplier
               LEFT JOIN purchase_items pi ON pi.purchase_header_id = ph.id AND pi.deleted = 0
               WHERE ph.deleted = 0
                 AND ph.dt_when BETWEEN '" + ДатОт + "' AND '" + ДатДо + "'"
               + УслФ + УслП
               + " GROUP BY ph.id, ph.no_number, ph.dt_when, ls.name, ph.sum_price_vat
                 ORDER BY ph.dt_when DESC, ph.id DESC";

        Рез = ВыполнитьSQL(Conn, SQL);
        КолЗагр = 0;
        Пока Не Рез.EOF Цикл
            С = ТаблицаПриходов.Добавить();
            С.ВетаисИД         = Строка(Рез.Fields.Item("id").Value);
            С.НомерНакладной   = Строка(Рез.Fields.Item("no_number").Value);
            ДтС = Рез.Fields.Item("dt_when").Value;
            Попытка С.ДатаНакладной = Дата(Строка(ДтС)); Исключение С.ДатаНакладной = '00010101'; КонецПопытки;
            С.НазваниеПоставщика = Строка(Рез.Fields.Item("supplier_name").Value);
            С.Сумма              = Число(Строка(Рез.Fields.Item("total").Value));
            С.КолСтрок           = Число(Строка(Рез.Fields.Item("cnt_items").Value));

            // ── Проверка дублей: есть ли в 1С «Поступление» с таким номером? ──
            НомВх = С.НомерНакладной;
            ВыбДубль = Документы.ПоступлениеТоваровУслуг.Выбрать(
                ДобавитьМесяц(ТекущаяДата(), -24), ТекущаяДата());
            НайденДубль = Ложь;
            Пока ВыбДубль.Следующий() Цикл
                Если Строка(ВыбДубль.НомерВходящегоДокумента) = НомВх Тогда
                    НайденДубль = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            С.СтатусДубль = ?(НайденДубль, "✅ В 1С есть", "Не импортирован");
            С.Выбрать = НЕ НайденДубль; // автовыбор только непроведённых

            КолЗагр = КолЗагр + 1;
            Рез.MoveNext();
        КонецЦикла;
        Рез.Close();
        ЗакрытьСоединение(Conn);

        УжеВ1С = 0; НеИмп = 0;
        Для Каждого С Из ТаблицаПриходов Цикл
            Если С.СтатусДубль = "✅ В 1С есть" Тогда УжеВ1С = УжеВ1С + 1;
            Иначе НеИмп = НеИмп + 1; КонецЕсли;
        КонецЦикла;
        РезультатОтчета = "✅ Накладных из Vetais: " + КолЗагр
            + "   (✅ уже в 1С: " + УжеВ1С + "   ⬜ не импортировано: " + НеИмп + ")" + Символы.ПС
            + "Отметьте нужные строки и нажмите «Создать в 1С».";
    Исключение
        РезультатОтчета = "❌ Ошибка загрузки приходов: " + ОписаниеОшибки();
        Попытка ЗакрытьСоединение(Conn); Исключение КонецПопытки;
    КонецПопытки;
КонецПроцедуры

// ──────────────────────────────────────────────────────────────────────
// РЕЖИМ 3: Создание выбранных накладных в 1С
// ──────────────────────────────────────────────────────────────────────
&НаСервере
Процедура СоздатьВыбранныеВ1СНаСервере()
    Попытка
        Conn = ОткрытьСоединение();

        // Загрузить номенклатуру Vetais → 1С (индексы для быстрого поиска)
        // Индексируем: ean → 1С ссылка, id_1c → 1С ссылка, name → 1С ссылка
        Инд_ean  = Новый Соответствие();
        Инд_1c   = Новый Соответствие();
        Инд_name = Новый Соответствие();
        Выб1СНом = Справочники.Номенклатура.Выбрать();
        Пока Выб1СНом.Следующий() Цикл
            НомСтр = Выб1СНом.Ссылка;
            ШтрК   = НРег(СокрЛП(Строка(Выб1СНом.Штрихкод)));
            Код1С  = НРег(СокрЛП(Строка(Выб1СНом.Код)));
            НМН    = НРег(СокрЛП(Строка(Выб1СНом.Наименование)));
            Если НЕ ПустаяСтрока(ШтрК) Тогда Инд_ean.Вставить(ШтрК, НомСтр); КонецЕсли;
            Если НЕ ПустаяСтрока(Код1С) Тогда Инд_1c.Вставить(Код1С, НомСтр); КонецЕсли;
            Если НЕ ПустаяСтрока(НМН)   Тогда Инд_name.Вставить(НМН, НомСтр); КонецЕсли;
        КонецЦикла;

        СоздКол = 0; ДублКол = 0; ОшибкКол = 0;
        Для Каждого СтрП Из ТаблицаПриходов Цикл
            Если НЕ СтрП.Выбрать Тогда Продолжить; КонецЕсли;

            // ── Повторная проверка дублей (на случай если сделали несколько кликов) ──
            НомВх = СтрП.НомерНакладной;
            ВыбД = Документы.ПоступлениеТоваровУслуг.Выбрать(
                ДобавитьМесяц(ТекущаяДата(),-24), ТекущаяДата());
            Дубль = Ложь;
            Пока ВыбД.Следующий() Цикл
                Если Строка(ВыбД.НомерВходящегоДокумента) = НомВх Тогда Дубль = Истина; Прервать; КонецЕсли;
            КонецЦикла;
            Если Дубль Тогда
                СтрП.СтатусДубль = "✅ В 1С есть (пропущен)";
                ДублКол = ДублКол + 1;
                Продолжить;
            КонецЕсли;

            Попытка
                // ── Читаем строки purchase_items из Vetais ──
                РезСтр = ВыполнитьSQL(Conn,
                    "SELECT pi.id_stock_item::text AS item_id,
                            pi.stock_item_name,
                            COALESCE(si.ean_code,'') AS ean_code,
                            COALESCE(si.id_1c,'') AS id_1c,
                            pi.amount, pi.price_unit, pi.price_with_vat,
                            pi.unit_purchase_name, pi.vat_purchase_name,
                            pi.sarze, pi.dt_expiration
                     FROM purchase_items pi
                     LEFT JOIN stock_item si ON si.id = pi.id_stock_item
                     WHERE pi.purchase_header_id = " + СтрП.ВетаисИД + " AND pi.deleted = 0");

                // ── Создать документ «Поступление товаров и услуг» в 1С ──
                Д1С = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
                Д1С.Дата = ?(СтрП.ДатаНакладной <> '00010101', СтрП.ДатаНакладной, ТекущаяДата());
                Д1С.Организация              = ПрихИз_Организация;
                Если ЗначениеЗаполнено(ПрихИз_Склад) Тогда Д1С.Склад = ПрихИз_Склад; КонецЕсли;
                Д1С.НомерВходящегоДокумента  = СтрП.НомерНакладной;
                Д1С.ДатаВходящегоДокумента   = Д1С.Дата;
                Д1С.Комментарий              = "Vetais id=" + СтрП.ВетаисИД + " / " + СтрП.НазваниеПоставщика;

                СтрокНеСопост = 0;
                Пока Не РезСтр.EOF Цикл
                    НМН1С   = Неопределено;
                    ЕАН     = НРег(СокрЛП(Строка(РезСтр.Fields.Item("ean_code").Value)));
                    ID1C    = НРег(СокрЛП(Строка(РезСтр.Fields.Item("id_1c").Value)));
                    НМН_В   = НРег(СокрЛП(Строка(РезСтр.Fields.Item("stock_item_name").Value)));

                    // Поиск номенклатуры в 1С
                    Если НЕ ПустаяСтрока(ЕАН)  Тогда НМН1С = Инд_ean.Получить(ЕАН);  КонецЕсли;
                    Если НМН1С = Неопределено И НЕ ПустаяСтрока(ID1C) Тогда
                        НМН1С = Инд_1c.Получить(ID1C);
                    КонецЕсли;
                    Если НМН1С = Неопределено Тогда НМН1С = Инд_name.Получить(НМН_В); КонецЕсли;

                    Стр1С = Д1С.Товары.Добавить();
                    Если НМН1С <> Неопределено Тогда
                        Стр1С.Номенклатура = НМН1С;
                    Иначе
                        // Не нашли в 1С — записываем название в комментарий строки
                        Стр1С.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
                        СтрокНеСопост = СтрокНеСопост + 1;
                    КонецЕсли;
                    Стр1С.Количество  = Число(Строка(РезСтр.Fields.Item("amount").Value));
                    Стр1С.Цена        = Число(Строка(РезСтр.Fields.Item("price_unit").Value));
                    Стр1С.Сумма       = Число(Строка(РезСтр.Fields.Item("price_with_vat").Value));
                    Стр1С.СтавкаНДС   = ПрихИз_СтавкаНДС;
                    Стр1С.СуммаНДС    = 0;

                    РезСтр.MoveNext();
                КонецЦикла;
                РезСтр.Close();

                Д1С.Записать(РежимЗаписиДокумента.Запись);
                СтрП.СтатусДубль = "✅ Создан в 1С (" + СтрокНеСопост + " не сопост.)";
                СтрП.Выбрать = Ложь;
                СоздКол = СоздКол + 1;
            Исключение
                СтрП.СтатусДубль = "❌ Ошибка: " + Лев(ОписаниеОшибки(), 80);
                ОшибкКол = ОшибкКол + 1;
            КонецПопытки;
        КонецЦикла;

        ЗакрытьСоединение(Conn);
        РезультатОтчета =
            "✅ Создано документов в 1С: "  + СоздКол + Символы.ПС +
            "⚠️ Пропущено дублей:          " + ДублКол + Символы.ПС +
            "❌ Ошибок:                     " + ОшибкКол + Символы.ПС +
            "Проведите созданные документы для зачисления на склад.";
    Исключение
        РезультатОтчета = "❌ Критическая ошибка: " + ОписаниеОшибки();
        Попытка ЗакрытьСоединение(Conn); Исключение КонецПопытки;
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеФункции_ODBC

// ──── Открыть ADODB-соединение с Vetais ──────────────────────────────
&НаСервере
Функция ОткрытьСоединение()
    СтрПодкл =
        "Driver={PostgreSQL Unicode};"
        + "Server="   + ПодкХост + ";"
        + "Port="     + ПодкПорт + ";"
        + "Database=" + ПодкБаза + ";"
        + "Uid="      + ПодкПользователь + ";"
        + "Pwd="      + ПодкПароль + ";"
        + "Client_Encoding=UTF8;UseUnicode=True;BoolsAsChar=0;";
    ADO = Новый COMОбъект("ADODB.Connection");
    ADO.ConnectionString = СтрПодкл;
    ADO.CursorLocation = 3;
    ADO.Open();
    Возврат ADO;
КонецФункции

// ──── Выполнить SQL и вернуть RecordSet ──────────────────────────────
&НаСервере
Функция ВыполнитьSQL(Соединение, ТекстSQL)
    Команда = Новый COMОбъект("ADODB.Command");
    Команда.ActiveConnection = Соединение;
    Команда.CommandTimeout   = 120;
    Команда.CommandText      = ТекстSQL;
    Возврат Команда.Execute();
КонецФункции

// ──── Получить nextval из sequence ───────────────────────────────────
&НаСервере
Функция ПолучитьNextval(Соединение, ИмяПоследовательности)
    РС = ВыполнитьSQL(Соединение, "SELECT nextval('" + ИмяПоследовательности + "') AS v");
    Знч = Строка(РС.Fields.Item("v").Value);
    РС.Close();
    Возврат Знч;
КонецФункции

// ──── Закрыть соединение ─────────────────────────────────────────────
&НаСервере
Процедура ЗакрытьСоединение(Соединение)
    Попытка
        Если Соединение.State <> 0 Тогда Соединение.Close(); КонецЕсли;
    Исключение КонецПопытки;
КонецПроцедуры

// ──── Экранировать одинарные кавычки для SQL ─────────────────────────
&НаСервере
Функция Экр(Знач Ст)
    Возврат СтрЗаменить(Строка(Ст), "'", "''");
КонецФункции

