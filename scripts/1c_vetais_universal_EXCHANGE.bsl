    С.Вставить("ПрихВ_СкладИД",     ПрихВ_СкладИД);
    С.Вставить("ПрихВ_СубъектИД",   ПрихВ_СубъектИД);
    С.Вставить("ПрихВ_ПоставщикИД", ПрихВ_ПоставщикИД);
    С.Вставить("ПрихИз_ФилиалИД",   ПрихИз_ФилиалИД);
    С.Вставить("ПрихИз_ДатаС",      ПрихИз_ДатаС);
    С.Вставить("ПрихИз_ДатаПо",     ПрихИз_ДатаПо);
    С.Вставить("ПрихИз_Организация", ПрихИз_Организация);
    С.Вставить("ПрихИз_Склад",      ПрихИз_Склад);
    ХранилищеОбщихНастроек.Сохранить("VetaisUniversal", "v2", С);
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()
    Попытка
        С = ХранилищеОбщихНастроек.Загрузить("VetaisUniversal", "v2");
        Если ТипЗнч(С) <> Тип("Структура") Тогда Возврат; КонецЕсли;
        Если С.Свойство("ПодкХост")           Тогда ПодкХост           = С.ПодкХост;           КонецЕсли;
        Если С.Свойство("ПодкПорт")           Тогда ПодкПорт           = С.ПодкПорт;           КонецЕсли;
        Если С.Свойство("ПодкБаза")           Тогда ПодкБаза           = С.ПодкБаза;           КонецЕсли;
        Если С.Свойство("ПодкПользователь")   Тогда ПодкПользователь   = С.ПодкПользователь;   КонецЕсли;
        Если С.Свойство("ПодкПароль")         Тогда ПодкПароль         = С.ПодкПароль;         КонецЕсли;
        Если С.Свойство("Прод_ФилиалИД")      Тогда Прод_ФилиалИД      = С.Прод_ФилиалИД;      КонецЕсли;
        Если С.Свойство("Прод_ДатаС")         Тогда Прод_ДатаС         = С.Прод_ДатаС;         КонецЕсли;
        Если С.Свойство("Прод_ДатаПо")        Тогда Прод_ДатаПо        = С.Прод_ДатаПо;        КонецЕсли;
        Если С.Свойство("Прод_Организация")   Тогда Прод_Организация   = С.Прод_Организация;   КонецЕсли;
        Если С.Свойство("Прод_Склад")         Тогда Прод_Склад         = С.Прод_Склад;         КонецЕсли;
        Если С.Свойство("Прод_Номенклатура")  Тогда Прод_Номенклатура  = С.Прод_Номенклатура;  КонецЕсли;
        Если С.Свойство("Прод_СтавкаНДС")     Тогда Прод_СтавкаНДС     = С.Прод_СтавкаНДС;     КонецЕсли;
        Если С.Свойство("Прод_ВидОплатыБезнал") Тогда Прод_ВидОплатыБезнал = С.Прод_ВидОплатыБезнал; КонецЕсли;
        Если С.Свойство("ПрихВ_ФилиалИД")     Тогда ПрихВ_ФилиалИД     = С.ПрихВ_ФилиалИД;     КонецЕсли;
        Если С.Свойство("ПрихВ_СкладИД")      Тогда ПрихВ_СкладИД      = С.ПрихВ_СкладИД;      КонецЕсли;
        Если С.Свойство("ПрихВ_СубъектИД")    Тогда ПрихВ_СубъектИД    = С.ПрихВ_СубъектИД;    КонецЕсли;
        Если С.Свойство("ПрихВ_ПоставщикИД")  Тогда ПрихВ_ПоставщикИД  = С.ПрихВ_ПоставщикИД;  КонецЕсли;
        Если С.Свойство("ПрихИз_ФилиалИД")    Тогда ПрихИз_ФилиалИД    = С.ПрихИз_ФилиалИД;    КонецЕсли;
        Если С.Свойство("ПрихИз_ДатаС")       Тогда ПрихИз_ДатаС       = С.ПрихИз_ДатаС;       КонецЕсли;
        Если С.Свойство("ПрихИз_ДатаПо")      Тогда ПрихИз_ДатаПо      = С.ПрихИз_ДатаПо;      КонецЕсли;
        Если С.Свойство("ПрихИз_Организация") Тогда ПрихИз_Организация  = С.ПрихИз_Организация; КонецЕсли;
        Если С.Свойство("ПрихИз_Склад")       Тогда ПрихИз_Склад        = С.ПрихИз_Склад;       КонецЕсли;
    Исключение КонецПопытки;
КонецПроцедуры

#КонецОбласти
