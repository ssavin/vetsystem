#Область НастройкиПользователя

&НаСервере
Процедура СохранитьНастройкиНаСервере()
    С = Новый Структура;
    С.Вставить("ПодкХост",          ПодкХост);
    С.Вставить("ПодкПорт",          ПодкПорт);
    С.Вставить("ПодкБаза",          ПодкБаза);
    С.Вставить("ПодкПользователь",  ПодкПользователь);
    С.Вставить("ПодкПароль",        ПодкПароль);
    С.Вставить("Прод_ФилиалИД",     Прод_ФилиалИД);
    С.Вставить("Прод_ДатаС",        Прод_ДатаС);
    С.Вставить("Прод_ДатаПо",       Прод_ДатаПо);
    С.Вставить("Прод_Организация",  Прод_Организация);
    С.Вставить("Прод_Склад",        Прод_Склад);
    С.Вставить("Прод_Номенклатура", Прод_Номенклатура);
    С.Вставить("Прод_СтавкаНДС",    Прод_СтавкаНДС);
